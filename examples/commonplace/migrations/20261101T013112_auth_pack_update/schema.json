    {
      "name": {
        "namespace": "auth",
        "name": "provider_tokens"
      },
      "comment": "A provider's access and refresh tokens for one connected account, kept\nonly for providers the app configured with `store_tokens`, so the app\ncan call that provider's API for the person. Both are encrypted with the\nserver's keys and bound to the identity, so a copy of the database calls\nno one's API. Nobody reads them directly, not even their owner: the app\nasks [`Auth::provider_access_token`](crate::Auth), which refreshes them.\nDisconnecting the account, merging it away, or deleting the account\ndeletes them, and revokes them where the provider allows.",
      "columns": [
        {
          "name": "id",
          "type": {
            "kind": "uuid"
          },
          "nullable": false
        },
        {
          "name": "identity_id",
          "type": {
            "kind": "uuid"
          },
          "nullable": false,
          "comment": "The connected account they belong to: one set each."
        },
        {
          "name": "account_id",
          "type": {
            "kind": "uuid"
          },
          "nullable": false
        },
        {
          "name": "provider",
          "type": {
            "kind": "text",
            "max_len": 64
          },
          "nullable": false,
          "comment": "The provider's ID in `[auth.providers]`, such as `github`."
        },
        {
          "name": "access_token",
          "type": {
            "kind": "bytes"
          },
          "nullable": false,
          "comment": "The access token, AES-256-GCM-SIV under the newest key."
        },
        {
          "name": "refresh_token",
          "type": {
            "kind": "bytes"
          },
          "nullable": true,
          "comment": "The refresh token, sealed the same way, when the provider gave one."
        },
        {
          "name": "expires_at",
          "type": {
            "kind": "timestamp"
          },
          "nullable": true,
          "comment": "When the access token stops working, if the provider said."
        },
        {
          "name": "scope",
          "type": {
            "kind": "text",
            "max_len": 2048
          },
          "nullable": true,
          "comment": "The scopes the provider granted, as it listed them."
        },
        {
          "name": "updated_at",
          "type": {
            "kind": "timestamp"
          },
          "nullable": false,
          "comment": "When they were last replaced, at sign-in or by a refresh."
        },
        {
          "name": "created_at",
          "type": {
            "kind": "timestamp"
          },
          "nullable": false
        }
      ],
      "primary_key": [
        "id"
      ],
      "indexes": [
        {
          "name": "auth_provider_tokens_identity_id_key",
          "columns": [
            "identity_id"
          ],
          "unique": true
        },
        {
          "name": "auth_provider_tokens_account_id_idx",
          "columns": [
            "account_id"
          ]
        }
      ],
      "foreign_keys": [
        {
          "name": "auth_provider_tokens_identity_id_fkey",
