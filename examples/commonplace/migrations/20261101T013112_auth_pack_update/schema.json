          ],
          "unique": true
        }
      ],
      "foreign_keys": [
        {
          "name": "auth_totp_account_id_fkey",
          "columns": [
            "account_id"
          ],
          "references": {
            "namespace": "auth",
            "name": "accounts"
          },
          "referenced_columns": [
