          },
          "referenced_columns": [
            "id"
          ],
          "on_delete": "cascade"
        },
        {
          "name": "auth_provider_tokens_account_id_fkey",
          "columns": [
            "account_id"
          ],
          "references": {
            "namespace": "auth",
            "name": "accounts"
          },
          "referenced_columns": [
            "id"
          ],
          "on_delete": "cascade"
        }
      ]
    },
    {
      "name": {
