    {
      "name": {
        "namespace": "auth",
        "name": "sessions"
      },
      "comment": "A signed-in device. The tokens that prove it live only on the device:\nthis row keeps their SHA-256 hashes, so a copy of the database signs no\none in.\n\nA browser holds one token, in a cookie. A native app holds two: a\nshort-lived access token it sends with each request, and a refresh token\nthat trades for a new pair and works once.",
      "columns": [
        {
          "name": "id",
          "type": {
            "kind": "uuid"
          },
          "nullable": false
        },
        {
          "name": "account_id",
          "type": {
            "kind": "uuid"
          },
          "nullable": false
        },
        {
          "name": "token_hash",
          "type": {
            "kind": "bytes"
          },
          "nullable": false,
          "comment": "The cookie's token, or a native app's access token."
        },
        {
          "name": "access_expires_at",
          "type": {
            "kind": "timestamp"
          },
          "nullable": true,
          "comment": "When a native app's access token stops working, so it must refresh.\n`None` for a browser's cookie."
        },
        {
          "name": "refresh_hash",
          "type": {
            "kind": "bytes"
          },
          "nullable": true,
          "comment": "A native app's refresh token."
        },
        {
          "name": "previous_refresh_hash",
          "type": {
            "kind": "bytes"
          },
          "nullable": true,
          "comment": "The refresh token this one replaced. Seen again after a short grace,\nit means someone else has a copy, and the session ends."
        },
        {
          "name": "refreshed_at",
          "type": {
            "kind": "timestamp"
          },
          "nullable": true,
          "comment": "When the refresh token was last replaced."
        },
        {
          "name": "aal",
          "type": {
            "kind": "text"
          },
          "nullable": false
        },
        {
          "name": "authenticated_at",
          "type": {
            "kind": "timestamp"
          },
          "nullable": false,
          "comment": "When its owner last proved who they are, which carries over when the\nsession's token is replaced."
        },
        {
          "name": "mfa_at",
          "type": {
            "kind": "timestamp"
          },
          "nullable": true,
          "comment": "When its owner last completed a second factor."
        },
        {
          "name": "last_seen_at",
          "type": {
            "kind": "timestamp"
          },
          "nullable": false,
          "comment": "When the session was last used, to the minute."
        },
        {
          "name": "idle_expires_at",
          "type": {
            "kind": "timestamp"
          },
          "nullable": false,
          "comment": "When it ends unless it's used before then."
        },
        {
          "name": "expires_at",
          "type": {
            "kind": "timestamp"
          },
          "nullable": false,
          "comment": "When it ends however often it's used."
        },
        {
          "name": "device",
          "type": {
            "kind": "text",
            "max_len": 200
          },
          "nullable": false,
          "comment": "What signed in, such as \"Firefox on macOS\", for the list of devices."
        },
        {
          "name": "revoked_at",
          "type": {
            "kind": "timestamp"
          },
          "nullable": true,
          "comment": "When it was signed out or revoked."
        },
        {
          "name": "created_at",
          "type": {
            "kind": "timestamp"
          },
          "nullable": false
        }
      ],
      "primary_key": [
        "id"
      ],
      "indexes": [
        {
          "name": "auth_sessions_token_hash_key",
          "columns": [
            "token_hash"
          ],
          "unique": true
        },
        {
          "name": "auth_sessions_refresh_hash_key",
          "columns": [
            "refresh_hash"
          ],
          "unique": true
        },
        {
          "name": "auth_sessions_previous_refresh_hash_key",
          "columns": [
            "previous_refresh_hash"
          ],
          "unique": true
        }
      ],
      "foreign_keys": [
        {
          "name": "auth_sessions_account_id_fkey",
          "columns": [
            "account_id"
          ],
          "references": {
            "namespace": "auth",
            "name": "accounts"
          },
          "referenced_columns": [
            "id"
          ],
          "on_delete": "cascade"
        }
      ],
      "checks": [
        {
          "name": "auth_sessions_aal_values",
          "rule": {
            "kind": "one_of",
            "column": "aal",
            "values": [
              "aal1",
              "aal2"
            ]
          }
        }
      ]
    },
    {
      "name": {
        "namespace": "auth",
        "name": "totp"
      },
      "comment": "An account's authenticator app: the TOTP secret it shares with the\nserver. The secret is encrypted with the server's keys, so a copy of the\ndatabase can't produce codes, and bound to its account.",
