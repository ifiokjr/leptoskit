     → Explored — 1 search, 1 read

     The seconds use / instead of %, so 90 seconds prints 1:01. Fixing it:

  ┃
  ┃  ← Edit src/timer.rs
  ┃
  ┃     8       }                                                                  8       }
  ┃     9                                                                          9
  ┃    10       pub fn label(&self) -> String {                                   10       pub fn label(&self) -> String {
  ┃    11           let minutes = self.seconds / 60;                              11           let minutes = self.seconds / 60;
  ┃    12 -         let seconds = self.seconds / 60;                              12 +         let seconds = self.seconds % 60;
  ┃    13           format!("{minutes}:{seconds:02}")                             13           format!("{minutes}:{seconds:02}")
  ┃    14       }                                                                 14       }
  ┃    15   }                                                                     15   }
  ┃    16                                                                         16
  ┃

