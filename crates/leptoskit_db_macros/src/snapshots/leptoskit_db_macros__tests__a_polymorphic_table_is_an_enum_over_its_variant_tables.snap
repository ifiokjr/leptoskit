/// Which kind of [`Actor`] a row is, as its supertype row stores it.
#[derive(
    ::core::clone::Clone,
    ::core::marker::Copy,
    ::core::fmt::Debug,
    ::core::cmp::PartialEq,
    ::core::cmp::Eq,
    ::core::hash::Hash,
    ::core::cmp::PartialOrd,
    ::core::cmp::Ord,
    ::leptoskit_db::Enum,
)]
pub enum ActorKind {
    #[db(rename = "user")]
    User,
    #[db(rename = "crew")]
    Group,
}

/// What a client may see of a [`Actor`]: its variant's public type, tagged with its kind. Return this from server functions.
#[derive(
    ::core::clone::Clone,
    ::core::fmt::Debug,
    ::core::cmp::PartialEq,
    ::leptoskit_db::__private::serde::Serialize,
    ::leptoskit_db::__private::serde::Deserialize,
    ::leptoskit_db::__private::schemars::JsonSchema,
)]
#[serde(crate = "::leptoskit_db::__private::serde", tag = "kind", content = "row")]
#[schemars(crate = "::leptoskit_db::__private::schemars")]
pub enum PublicActor {
    #[serde(rename = "user")]
    User(PublicUser),
    #[serde(rename = "crew")]
    Group(groups::PublicGroup),
}

impl PublicActor {
    /// Which kind of row it is.
    pub fn kind(&self) -> ActorKind {
        match self {
            Self::User(_) => ActorKind::User,
            Self::Group(_) => ActorKind::Group,
        }
    }
}

