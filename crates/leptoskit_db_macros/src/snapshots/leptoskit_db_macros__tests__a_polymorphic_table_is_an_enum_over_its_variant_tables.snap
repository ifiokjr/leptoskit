/// Anything that can own a budget.
pub enum Actor {
    /// Someone.
    User(User),
    Group(groups::Group),
}
#[::leptoskit_db::table(name = "actors", live)]
#[db::policy(select, |actor, _|actor.kind.eq(ActorKind::User))]
/// The `actors` table: one row per `Actor`, of any kind, holding its key and its kind. Each variant's inserts and removals write it; don't write it yourself.
pub struct ActorRow {
    /// The key the variant row shares.
    #[db(key, generate = false, no_foreign_key)]
    pub id: ::leptoskit_db::Id<Actor>,
    /// Which variant table holds the row.
    pub kind: ActorKind,
}
