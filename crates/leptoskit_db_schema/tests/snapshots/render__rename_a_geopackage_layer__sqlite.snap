DROP TABLE "rtree_places_at";

DROP TABLE "rtree_places_at_rows";

DELETE FROM "gpkg_geometry_columns" WHERE "table_name" = 'places';

DELETE FROM "gpkg_contents" WHERE "table_name" = 'places';

ALTER TABLE "places" RENAME TO "sites";

CREATE TABLE "rtree_sites_at_rows" (
	"lk_row" INTEGER PRIMARY KEY,
	"id" INTEGER NOT NULL,
	CONSTRAINT "rtree_sites_at_rows_key" UNIQUE ("id")
) STRICT;

CREATE VIRTUAL TABLE "rtree_sites_at" USING rtree(id, minx, maxx, miny, maxy);

INSERT INTO "rtree_sites_at_rows" ("id") SELECT "id" FROM "sites";

INSERT INTO "rtree_sites_at" (id, minx, maxx, miny, maxy) SELECT "lk_rows"."lk_row", ST_MinX("sites"."at"), ST_MaxX("sites"."at"), ST_MinY("sites"."at"), ST_MaxY("sites"."at") FROM "sites" JOIN "rtree_sites_at_rows" AS "lk_rows" ON "lk_rows"."id" = "sites"."id" WHERE "sites"."at" IS NOT NULL AND NOT ST_IsEmpty("sites"."at");

CREATE TRIGGER "rtree_sites_at_insert" AFTER INSERT ON "sites" BEGIN
	INSERT INTO "rtree_sites_at_rows" ("id") VALUES (new."id");
	INSERT INTO "rtree_sites_at" (id, minx, maxx, miny, maxy) SELECT "lk_row", ST_MinX(new."at"), ST_MaxX(new."at"), ST_MinY(new."at"), ST_MaxY(new."at") FROM "rtree_sites_at_rows" WHERE "id" = new."id" AND new."at" IS NOT NULL AND NOT ST_IsEmpty(new."at");
END;

CREATE TRIGGER "rtree_sites_at_update" AFTER UPDATE OF "at", "id" ON "sites" BEGIN
	DELETE FROM "rtree_sites_at" WHERE id = (SELECT "lk_row" FROM "rtree_sites_at_rows" WHERE "id" = old."id");
	UPDATE "rtree_sites_at_rows" SET "id" = new."id" WHERE "id" = old."id";
	INSERT INTO "rtree_sites_at" (id, minx, maxx, miny, maxy) SELECT "lk_row", ST_MinX(new."at"), ST_MaxX(new."at"), ST_MinY(new."at"), ST_MaxY(new."at") FROM "rtree_sites_at_rows" WHERE "id" = new."id" AND new."at" IS NOT NULL AND NOT ST_IsEmpty(new."at");
END;

CREATE TRIGGER "rtree_sites_at_delete" AFTER DELETE ON "sites" BEGIN
	DELETE FROM "rtree_sites_at" WHERE id = (SELECT "lk_row" FROM "rtree_sites_at_rows" WHERE "id" = old."id");
	DELETE FROM "rtree_sites_at_rows" WHERE "id" = old."id";
END;

CREATE TABLE IF NOT EXISTS "gpkg_spatial_ref_sys" (
	"srs_name" TEXT NOT NULL,
	"srs_id" INTEGER NOT NULL PRIMARY KEY,
	"organization" TEXT NOT NULL,
	"organization_coordsys_id" INTEGER NOT NULL,
	"definition" TEXT NOT NULL,
	"description" TEXT
);

CREATE TABLE IF NOT EXISTS "gpkg_contents" (
	"table_name" TEXT NOT NULL PRIMARY KEY,
	"data_type" TEXT NOT NULL,
	"identifier" TEXT UNIQUE,
	"description" TEXT DEFAULT '',
	"last_change" DATETIME NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
	"min_x" DOUBLE,
	"min_y" DOUBLE,
	"max_x" DOUBLE,
	"max_y" DOUBLE,
	"srs_id" INTEGER,
	CONSTRAINT "fk_gc_r_srs_id" FOREIGN KEY ("srs_id") REFERENCES "gpkg_spatial_ref_sys" ("srs_id")
);

CREATE TABLE IF NOT EXISTS "gpkg_geometry_columns" (
	"table_name" TEXT NOT NULL,
	"column_name" TEXT NOT NULL,
	"geometry_type_name" TEXT NOT NULL,
	"srs_id" INTEGER NOT NULL,
	"z" TINYINT NOT NULL,
	"m" TINYINT NOT NULL,
	CONSTRAINT "pk_geom_cols" PRIMARY KEY ("table_name", "column_name"),
	CONSTRAINT "uk_gc_table_name" UNIQUE ("table_name"),
	CONSTRAINT "fk_gc_tn" FOREIGN KEY ("table_name") REFERENCES "gpkg_contents" ("table_name"),
	CONSTRAINT "fk_gc_srs" FOREIGN KEY ("srs_id") REFERENCES "gpkg_spatial_ref_sys" ("srs_id")
);

