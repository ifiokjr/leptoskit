CREATE TABLE "places" (
	"id" INTEGER NOT NULL,
	"at" BLOB NOT NULL CHECK (lk_geo_check("at", 'Point', 27700, 0)),
	CONSTRAINT "places_pkey" PRIMARY KEY ("id")
) STRICT;

CREATE TABLE "rtree_places_at_rows" (
	"lk_row" INTEGER PRIMARY KEY,
	"id" INTEGER NOT NULL,
	CONSTRAINT "rtree_places_at_rows_key" UNIQUE ("id")
) STRICT;

CREATE VIRTUAL TABLE "rtree_places_at" USING rtree(id, minx, maxx, miny, maxy);

INSERT INTO "rtree_places_at_rows" ("id") SELECT "id" FROM "places";

INSERT INTO "rtree_places_at" (id, minx, maxx, miny, maxy) SELECT "lk_rows"."lk_row", ST_MinX("places"."at"), ST_MaxX("places"."at"), ST_MinY("places"."at"), ST_MaxY("places"."at") FROM "places" JOIN "rtree_places_at_rows" AS "lk_rows" ON "lk_rows"."id" = "places"."id" WHERE "places"."at" IS NOT NULL AND NOT ST_IsEmpty("places"."at");

CREATE TRIGGER "rtree_places_at_insert" AFTER INSERT ON "places" BEGIN
	INSERT INTO "rtree_places_at_rows" ("id") VALUES (new."id");
	INSERT INTO "rtree_places_at" (id, minx, maxx, miny, maxy) SELECT "lk_row", ST_MinX(new."at"), ST_MaxX(new."at"), ST_MinY(new."at"), ST_MaxY(new."at") FROM "rtree_places_at_rows" WHERE "id" = new."id" AND new."at" IS NOT NULL AND NOT ST_IsEmpty(new."at");
END;

CREATE TRIGGER "rtree_places_at_update" AFTER UPDATE OF "at", "id" ON "places" BEGIN
	DELETE FROM "rtree_places_at" WHERE id = (SELECT "lk_row" FROM "rtree_places_at_rows" WHERE "id" = old."id");
	UPDATE "rtree_places_at_rows" SET "id" = new."id" WHERE "id" = old."id";
	INSERT INTO "rtree_places_at" (id, minx, maxx, miny, maxy) SELECT "lk_row", ST_MinX(new."at"), ST_MaxX(new."at"), ST_MinY(new."at"), ST_MaxY(new."at") FROM "rtree_places_at_rows" WHERE "id" = new."id" AND new."at" IS NOT NULL AND NOT ST_IsEmpty(new."at");
END;

CREATE TRIGGER "rtree_places_at_delete" AFTER DELETE ON "places" BEGIN
	DELETE FROM "rtree_places_at" WHERE id = (SELECT "lk_row" FROM "rtree_places_at_rows" WHERE "id" = old."id");
	DELETE FROM "rtree_places_at_rows" WHERE "id" = old."id";
END;

CREATE TABLE IF NOT EXISTS "gpkg_spatial_ref_sys" (
	"srs_name" TEXT NOT NULL,
	"srs_id" INTEGER NOT NULL PRIMARY KEY,
	"organization" TEXT NOT NULL,
	"organization_coordsys_id" INTEGER NOT NULL,
	"definition" TEXT NOT NULL,
	"description" TEXT
);

CREATE TABLE IF NOT EXISTS "gpkg_contents" (
	"table_name" TEXT NOT NULL PRIMARY KEY,
	"data_type" TEXT NOT NULL,
	"identifier" TEXT UNIQUE,
	"description" TEXT DEFAULT '',
	"last_change" DATETIME NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
	"min_x" DOUBLE,
	"min_y" DOUBLE,
	"max_x" DOUBLE,
	"max_y" DOUBLE,
	"srs_id" INTEGER,
	CONSTRAINT "fk_gc_r_srs_id" FOREIGN KEY ("srs_id") REFERENCES "gpkg_spatial_ref_sys" ("srs_id")
);

CREATE TABLE IF NOT EXISTS "gpkg_geometry_columns" (
	"table_name" TEXT NOT NULL,
	"column_name" TEXT NOT NULL,
	"geometry_type_name" TEXT NOT NULL,
	"srs_id" INTEGER NOT NULL,
	"z" TINYINT NOT NULL,
	"m" TINYINT NOT NULL,
	CONSTRAINT "pk_geom_cols" PRIMARY KEY ("table_name", "column_name"),
	CONSTRAINT "uk_gc_table_name" UNIQUE ("table_name"),
	CONSTRAINT "fk_gc_tn" FOREIGN KEY ("table_name") REFERENCES "gpkg_contents" ("table_name"),
	CONSTRAINT "fk_gc_srs" FOREIGN KEY ("srs_id") REFERENCES "gpkg_spatial_ref_sys" ("srs_id")
);

