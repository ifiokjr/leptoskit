-- @generated by leptoskit db. Edits are allowed: the migration is applied as written, and schema.json beside it records the schema it produces.
-- dialect: postgres

CREATE SCHEMA IF NOT EXISTS "live";

CREATE TABLE "live"."changes" (
	"seq" bigint NOT NULL,
	"txid" bigint,
	"version" bigint,
	"table_name" text NOT NULL,
	"op" text NOT NULL,
	"key" jsonb NOT NULL,
	"old" jsonb,
	"new" jsonb,
	"changed" jsonb,
	CONSTRAINT "live_changes_pkey" PRIMARY KEY ("seq"),
	CONSTRAINT "live_changes_op_values" CHECK ("op" IN ('I', 'U', 'D'))
);

CREATE INDEX "live_changes_txid_idx" ON "live"."changes" ("txid");

CREATE INDEX "live_changes_version_idx" ON "live"."changes" ("version");

CREATE TABLE "live"."commits" (
	"version" bigint NOT NULL,
	"txid" bigint,
	"committed_at" timestamptz NOT NULL,
	"actor" uuid,
	"origin" text NOT NULL,
	CONSTRAINT "live_commits_pkey" PRIMARY KEY ("version")
);

CREATE UNIQUE INDEX "live_commits_txid_key" ON "live"."commits" ("txid");

CREATE TABLE "live"."pending" (
	"txid" bigint NOT NULL,
	CONSTRAINT "live_pending_pkey" PRIMARY KEY ("txid")
);

CREATE SEQUENCE "live"."change_seq";

CREATE SEQUENCE "live"."version_seq";

CREATE OR REPLACE FUNCTION "live"."capture"() RETURNS trigger LANGUAGE plpgsql SECURITY DEFINER SET search_path = pg_catalog, pg_temp AS $leptoskit$
DECLARE
	captured_table text := TG_ARGV[0];
	key_columns text[] := string_to_array(TG_ARGV[1], ',');
	copied_columns text[] := TG_ARGV[2:TG_NARGS - 1];
	current_txid bigint := pg_current_xact_id()::text::bigint;
	old_row jsonb;
	new_row jsonb;
	changed_columns jsonb := '[]'::jsonb;
BEGIN
	IF TG_OP <> 'INSERT' THEN
		old_row := to_jsonb(OLD);
	END IF;

	IF TG_OP <> 'DELETE' THEN
		new_row := to_jsonb(NEW);
	END IF;

	IF TG_OP = 'UPDATE' THEN
		SELECT coalesce(jsonb_agg(entry.key ORDER BY entry.key), '[]'::jsonb)
		INTO changed_columns
		FROM jsonb_each(new_row) AS entry
		WHERE entry.value IS DISTINCT FROM old_row -> entry.key;

		IF changed_columns = '[]'::jsonb THEN
			RETURN NULL;
		END IF;
	END IF;

	INSERT INTO live.changes ("seq", "txid", "version", "table_name", "op", "key", "old", "new", "changed")
	VALUES (
		nextval('live.change_seq'),
		current_txid,
		NULL,
		captured_table,
		left(TG_OP, 1),
		(SELECT jsonb_agg(coalesce(new_row, old_row) -> part.name ORDER BY part.position)
			FROM unnest(key_columns) WITH ORDINALITY AS part(name, position)),
		(SELECT jsonb_object_agg(copied.name, old_row -> copied.name)
			FROM unnest(copied_columns) AS copied(name) WHERE old_row IS NOT NULL),
		(SELECT jsonb_object_agg(copied.name, new_row -> copied.name)
			FROM unnest(copied_columns) AS copied(name) WHERE new_row IS NOT NULL),
		changed_columns
	);

	-- The first write in this transaction registers it for a version at commit.
	INSERT INTO live.pending (txid) VALUES (current_txid) ON CONFLICT DO NOTHING;
	RETURN NULL;
END;
$leptoskit$;

CREATE OR REPLACE FUNCTION "live"."seal"() RETURNS trigger LANGUAGE plpgsql SECURITY DEFINER SET search_path = pg_catalog, pg_temp AS $leptoskit$
DECLARE
	next_version bigint;
BEGIN
	DELETE FROM live.pending WHERE txid = NEW.txid;

	-- Sealed already: `SET CONSTRAINTS ALL IMMEDIATE` ran this before a later
	-- write registered the transaction again. Its changes join the version it has.
	IF EXISTS (SELECT 1 FROM live.commits WHERE txid = NEW.txid) THEN
		RETURN NULL;
	END IF;

	PERFORM pg_advisory_xact_lock(7812448352492680805);
	next_version := nextval('live.version_seq');
	INSERT INTO live.commits (version, txid, committed_at, actor, origin)
	VALUES (
		next_version,
		NEW.txid,
		clock_timestamp(),
		nullif(current_setting('leptoskit.user_id', true), '')::uuid,
		coalesce(nullif(current_setting('leptoskit.origin', true), ''), 'sql')
	);
	PERFORM pg_notify('leptoskit_live', next_version::text);
	RETURN NULL;
END;
$leptoskit$;

CREATE TRIGGER "live_capture" AFTER INSERT OR UPDATE OR DELETE ON "posts" FOR EACH ROW EXECUTE FUNCTION "live"."capture"('posts', 'id', 'id', 'author_id', 'title', 'score');

CREATE TRIGGER "live_capture" AFTER INSERT OR UPDATE OR DELETE ON "users" FOR EACH ROW EXECUTE FUNCTION "live"."capture"('users', 'id', 'id', 'handle');

CREATE CONSTRAINT TRIGGER "seal" AFTER INSERT ON "live"."pending" DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION "live"."seal"();
