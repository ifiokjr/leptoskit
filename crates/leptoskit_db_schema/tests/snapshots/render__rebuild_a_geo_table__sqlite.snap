CREATE TABLE "_leptoskit_rebuild_posts" (
	"id" INTEGER NOT NULL,
	"author_id" INTEGER NOT NULL,
	"title" TEXT NOT NULL,
	"body" TEXT,
	"score" INTEGER NOT NULL DEFAULT 0 CHECK ("score" BETWEEN -2147483648 AND 2147483647),
	"status" TEXT NOT NULL DEFAULT 'draft',
	"location" BLOB CHECK (lk_geo_check("location", 'Point', 4326, 1)),
	"boundary" BLOB CHECK (lk_geo_check("boundary", 'Polygon', 27700, 0)),
	CONSTRAINT "posts_pkey" PRIMARY KEY ("id"),
	CONSTRAINT "posts_author_id_fkey" FOREIGN KEY ("author_id") REFERENCES "users" ("id") ON DELETE CASCADE,
	CONSTRAINT "posts_score_check" CHECK ("score" >= 0 AND "score" <= 200),
	CONSTRAINT "posts_status_check" CHECK ("status" IN ('draft', 'published')),
	CONSTRAINT "posts_boundary_valid" CHECK (lk_st_isvalid("boundary"))
) STRICT;

INSERT INTO "_leptoskit_rebuild_posts" ("id", "author_id", "title", "body", "score", "status", "location", "boundary") SELECT "id", "author_id", "title", "body", "score", "status", "location", "boundary" FROM "posts";

DROP TABLE "posts";

ALTER TABLE "_leptoskit_rebuild_posts" RENAME TO "posts";

