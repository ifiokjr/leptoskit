CREATE TRIGGER "rtree_posts_location_insert" AFTER INSERT ON "posts" BEGIN
	INSERT INTO "rtree_posts_location_rows" ("id") VALUES (new."id");
	INSERT INTO "rtree_posts_location" (id, minx, maxx, miny, maxy) SELECT "lk_row", ST_MinX(new."location"), ST_MaxX(new."location"), ST_MinY(new."location"), ST_MaxY(new."location") FROM "rtree_posts_location_rows" WHERE "id" = new."id" AND new."location" IS NOT NULL AND NOT ST_IsEmpty(new."location");
END;

CREATE TRIGGER "rtree_posts_location_update" AFTER UPDATE OF "location", "id" ON "posts" BEGIN
	DELETE FROM "rtree_posts_location" WHERE id = (SELECT "lk_row" FROM "rtree_posts_location_rows" WHERE "id" = old."id");
	UPDATE "rtree_posts_location_rows" SET "id" = new."id" WHERE "id" = old."id";
	INSERT INTO "rtree_posts_location" (id, minx, maxx, miny, maxy) SELECT "lk_row", ST_MinX(new."location"), ST_MaxX(new."location"), ST_MinY(new."location"), ST_MaxY(new."location") FROM "rtree_posts_location_rows" WHERE "id" = new."id" AND new."location" IS NOT NULL AND NOT ST_IsEmpty(new."location");
END;

CREATE TRIGGER "rtree_posts_location_delete" AFTER DELETE ON "posts" BEGIN
	DELETE FROM "rtree_posts_location" WHERE id = (SELECT "lk_row" FROM "rtree_posts_location_rows" WHERE "id" = old."id");
	DELETE FROM "rtree_posts_location_rows" WHERE "id" = old."id";
