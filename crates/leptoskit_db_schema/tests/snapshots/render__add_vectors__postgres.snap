-- @generated by leptoskit db. Edits are allowed: the migration is applied as written, and schema.json beside it records the schema it produces.
-- dialect: postgres

CREATE EXTENSION IF NOT EXISTS "vector";

CREATE TABLE "items" (
	"id" bigint NOT NULL,
	"v" halfvec(4) NOT NULL,
	CONSTRAINT "items_pkey" PRIMARY KEY ("id")
);

ALTER TABLE "posts" ADD COLUMN "embedding" vector(3);

ALTER TABLE "posts" ADD COLUMN "code" bit(16);

ALTER TABLE "posts" ADD COLUMN "lk_embedding_source" text;

CREATE INDEX "posts_embedding_hnsw" ON "posts" USING hnsw ("embedding" vector_cosine_ops);

UPDATE "posts" SET "lk_embedding_source" = encode(sha256(convert_to(coalesce(octet_length("title")::text || ':' || "title", '-') || ';' || coalesce(octet_length("body")::text || ':' || "body", '-') || ';', 'UTF8')), 'hex') WHERE "embedding" IS NOT NULL AND "lk_embedding_source" IS NULL;

CREATE FUNCTION "posts_lk_embedding_source"() RETURNS trigger LANGUAGE plpgsql AS $lk$
BEGIN
	IF TG_OP = 'INSERT' THEN
		IF NEW."lk_embedding_source" IS NULL AND NEW."embedding" IS NOT NULL THEN
			NEW."lk_embedding_source" := encode(sha256(convert_to(coalesce(octet_length(NEW."title")::text || ':' || NEW."title", '-') || ';' || coalesce(octet_length(NEW."body")::text || ':' || NEW."body", '-') || ';', 'UTF8')), 'hex');
		END IF;
	ELSIF NEW."embedding" IS DISTINCT FROM OLD."embedding" AND NEW."lk_embedding_source" IS NOT DISTINCT FROM OLD."lk_embedding_source" THEN
		NEW."lk_embedding_source" := CASE WHEN NEW."embedding" IS NULL THEN NULL ELSE encode(sha256(convert_to(coalesce(octet_length(NEW."title")::text || ':' || NEW."title", '-') || ';' || coalesce(octet_length(NEW."body")::text || ':' || NEW."body", '-') || ';', 'UTF8')), 'hex') END;
	END IF;
	RETURN NEW;
END
$lk$;

CREATE TRIGGER "posts_lk_embedding_source" BEFORE INSERT OR UPDATE OF "embedding" ON "posts" FOR EACH ROW EXECUTE FUNCTION "posts_lk_embedding_source"();

CREATE INDEX "posts_code_ivfflat" ON "posts" USING ivfflat ("code" bit_hamming_ops) WITH (lists = 100);

CREATE INDEX "items_v_ivfflat" ON "items" USING ivfflat ("v" halfvec_ip_ops) WITH (lists = 100);
