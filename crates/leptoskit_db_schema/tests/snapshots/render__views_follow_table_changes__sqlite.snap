--
-- loses data: `posts.title` changes from text to text(200); values may not convert

DROP VIEW "post_counts";

DROP TABLE "published_posts";

DROP VIEW "reports_long_titles";

CREATE TABLE "_leptoskit_rebuild_posts" (
	"id" INTEGER NOT NULL,
	"author_id" INTEGER NOT NULL,
	"title" TEXT NOT NULL CHECK (length("title") <= 200),
	"body" TEXT,
	"score" INTEGER NOT NULL DEFAULT 0 CHECK ("score" BETWEEN -2147483648 AND 2147483647),
	"status" TEXT NOT NULL DEFAULT 'draft',
	CONSTRAINT "posts_pkey" PRIMARY KEY ("id"),
	CONSTRAINT "posts_author_id_fkey" FOREIGN KEY ("author_id") REFERENCES "users" ("id") ON DELETE CASCADE,
	CONSTRAINT "posts_score_check" CHECK ("score" >= 0 AND "score" <= 100),
	CONSTRAINT "posts_status_check" CHECK ("status" IN ('draft', 'published'))
) STRICT;

INSERT INTO "_leptoskit_rebuild_posts" ("id", "author_id", "title", "body", "score", "status") SELECT "id", "author_id", "title", "body", "score", "status" FROM "posts";

DROP TABLE "posts";

ALTER TABLE "_leptoskit_rebuild_posts" RENAME TO "posts";

CREATE INDEX "posts_author_id_idx" ON "posts" ("author_id");

CREATE VIEW "post_counts" ("author_id", "posts") AS
SELECT author_id, count(*) FROM posts GROUP BY author_id;

CREATE TABLE "published_posts" (
	"id" INTEGER NOT NULL,
	"title" TEXT NOT NULL
) STRICT;

INSERT INTO "published_posts" ("id", "title")
SELECT id, title FROM posts WHERE status = 'published';

CREATE VIEW "reports_long_titles" ("id") AS
SELECT id FROM posts WHERE length(title) > 4;
