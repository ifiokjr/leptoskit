CREATE TRIGGER "posts_lk_vec_embedding_delete" AFTER DELETE ON "posts" BEGIN
	DELETE FROM "posts_lk_vec_embedding" WHERE rowid = (SELECT "lk_row" FROM "posts_lk_vec_embedding_rows" WHERE "id" = old."id");
	DELETE FROM "posts_lk_vec_embedding_rows" WHERE "id" = old."id";
