UPDATE "posts" SET "lk_embedding_source" = lk_sha256(coalesce(octet_length("title") || ':' || "title", '-') || ';' || coalesce(octet_length("body") || ':' || "body", '-') || ';') WHERE "embedding" IS NOT NULL AND "lk_embedding_source" IS NULL;

CREATE TRIGGER "posts_lk_embedding_source_insert" AFTER INSERT ON "posts" WHEN new."lk_embedding_source" IS NULL AND new."embedding" IS NOT NULL BEGIN
	UPDATE "posts" SET "lk_embedding_source" = lk_sha256(coalesce(octet_length(new."title") || ':' || new."title", '-') || ';' || coalesce(octet_length(new."body") || ':' || new."body", '-') || ';') WHERE "id" = new."id";
END;

CREATE TRIGGER "posts_lk_embedding_source_update" AFTER UPDATE OF "embedding" ON "posts" WHEN new."embedding" IS NOT old."embedding" AND new."lk_embedding_source" IS old."lk_embedding_source" BEGIN
	UPDATE "posts" SET "lk_embedding_source" = CASE WHEN new."embedding" IS NULL THEN NULL ELSE lk_sha256(coalesce(octet_length(new."title") || ':' || new."title", '-') || ';' || coalesce(octet_length(new."body") || ':' || new."body", '-') || ';') END WHERE "id" = new."id";
END;

