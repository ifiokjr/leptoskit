	"v" BLOB NOT NULL CHECK (length("v") = 16),
	CONSTRAINT "items_pkey" PRIMARY KEY ("id")
) STRICT;

ALTER TABLE "posts" ADD COLUMN "embedding" BLOB CHECK (length("embedding") = 12);

ALTER TABLE "posts" ADD COLUMN "code" BLOB CHECK (length("code") = 2);

ALTER TABLE "posts" ADD COLUMN "lk_embedding_source" TEXT;

CREATE TABLE "posts_lk_vec_embedding_rows" (
	"lk_row" INTEGER PRIMARY KEY,
	"id" INTEGER NOT NULL,
	CONSTRAINT "posts_lk_vec_embedding_rows_key" UNIQUE ("id")
) STRICT;

CREATE VIRTUAL TABLE "posts_lk_vec_embedding" USING vec0(lk_vector float[3] distance_metric=cosine);

INSERT INTO "posts_lk_vec_embedding_rows" ("id") SELECT "id" FROM "posts";

INSERT INTO "posts_lk_vec_embedding" (rowid, lk_vector) SELECT "lk_rows"."lk_row", "posts"."embedding" FROM "posts" JOIN "posts_lk_vec_embedding_rows" AS "lk_rows" ON "lk_rows"."id" = "posts"."id" WHERE "posts"."embedding" IS NOT NULL;

CREATE TRIGGER "posts_lk_vec_embedding_insert_null" AFTER INSERT ON "posts" WHEN new."embedding" IS NULL BEGIN
	INSERT INTO "posts_lk_vec_embedding_rows" ("id") VALUES (new."id");
END;

CREATE TRIGGER "posts_lk_vec_embedding_insert" AFTER INSERT ON "posts" WHEN new."embedding" IS NOT NULL BEGIN
	INSERT INTO "posts_lk_vec_embedding_rows" ("id") VALUES (new."id");
	INSERT INTO "posts_lk_vec_embedding" (rowid, lk_vector) VALUES ((SELECT "lk_row" FROM "posts_lk_vec_embedding_rows" WHERE "id" = new."id"), new."embedding");
END;

CREATE TRIGGER "posts_lk_vec_embedding_update_null" AFTER UPDATE OF "embedding", "id" ON "posts" WHEN new."embedding" IS NULL BEGIN
	DELETE FROM "posts_lk_vec_embedding" WHERE rowid = (SELECT "lk_row" FROM "posts_lk_vec_embedding_rows" WHERE "id" = old."id");
	UPDATE "posts_lk_vec_embedding_rows" SET "id" = new."id" WHERE "id" = old."id";
END;

CREATE TRIGGER "posts_lk_vec_embedding_update" AFTER UPDATE OF "embedding", "id" ON "posts" WHEN new."embedding" IS NOT NULL BEGIN
	DELETE FROM "posts_lk_vec_embedding" WHERE rowid = (SELECT "lk_row" FROM "posts_lk_vec_embedding_rows" WHERE "id" = old."id");
	UPDATE "posts_lk_vec_embedding_rows" SET "id" = new."id" WHERE "id" = old."id";
