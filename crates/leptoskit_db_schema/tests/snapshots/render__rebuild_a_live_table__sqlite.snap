CREATE TRIGGER "live_posts_update" AFTER UPDATE ON "posts" FOR EACH ROW WHEN OLD."author_id" IS NOT NEW."author_id" OR OLD."body" IS NOT NEW."body" OR OLD."id" IS NOT NEW."id" OR OLD."score" IS NOT NEW."score" OR OLD."status" IS NOT NEW."status" OR OLD."title" IS NOT NEW."title" BEGIN
	INSERT INTO "live_changes" ("seq", "txid", "version", "table_name", "op", "key", "old", "new", "changed") VALUES ((SELECT coalesce(max("seq"), 0) + 1 FROM "live_changes"), NULL, NULL, 'posts', 'U', json_array(NEW."id"), json_object('id', OLD."id", 'author_id', OLD."author_id", 'title', OLD."title", 'score', OLD."score"), json_object('id', NEW."id", 'author_id', NEW."author_id", 'title', NEW."title", 'score', NEW."score"), (SELECT json_group_array("value") FROM json_each(json_array(CASE WHEN OLD."author_id" IS NOT NEW."author_id" THEN 'author_id' END, CASE WHEN OLD."body" IS NOT NEW."body" THEN 'body' END, CASE WHEN OLD."id" IS NOT NEW."id" THEN 'id' END, CASE WHEN OLD."score" IS NOT NEW."score" THEN 'score' END, CASE WHEN OLD."status" IS NOT NEW."status" THEN 'status' END, CASE WHEN OLD."title" IS NOT NEW."title" THEN 'title' END)) WHERE "type" <> 'null'));
