	INSERT INTO "live_changes" ("seq", "txid", "version", "table_name", "op", "key", "old", "new", "changed") VALUES ((SELECT coalesce(max("seq"), 0) + 1 FROM "live_changes"), NULL, NULL, 'posts', 'D', json_array(OLD."id"), json_object('id', OLD."id", 'author_id', OLD."author_id", 'title', OLD."title", 'score', OLD."score"), NULL, '[]');
