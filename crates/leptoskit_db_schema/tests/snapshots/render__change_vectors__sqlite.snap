CREATE TABLE "posts_lk_vec_meaning_rows" (
	"lk_row" INTEGER PRIMARY KEY,
	"id" INTEGER NOT NULL,
	CONSTRAINT "posts_lk_vec_meaning_rows_key" UNIQUE ("id")
) STRICT;

CREATE VIRTUAL TABLE "posts_lk_vec_meaning" USING vec0(lk_vector float[3] distance_metric=cosine);

INSERT INTO "posts_lk_vec_meaning_rows" ("id") SELECT "id" FROM "posts";

INSERT INTO "posts_lk_vec_meaning" (rowid, lk_vector) SELECT "lk_rows"."lk_row", "posts"."meaning" FROM "posts" JOIN "posts_lk_vec_meaning_rows" AS "lk_rows" ON "lk_rows"."id" = "posts"."id" WHERE "posts"."meaning" IS NOT NULL;

CREATE TRIGGER "posts_lk_vec_meaning_insert_null" AFTER INSERT ON "posts" WHEN new."meaning" IS NULL BEGIN
	INSERT INTO "posts_lk_vec_meaning_rows" ("id") VALUES (new."id");
