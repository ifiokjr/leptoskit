CREATE TRIGGER "posts_lk_vec_meaning_insert" AFTER INSERT ON "posts" WHEN new."meaning" IS NOT NULL BEGIN
	INSERT INTO "posts_lk_vec_meaning_rows" ("id") VALUES (new."id");
	INSERT INTO "posts_lk_vec_meaning" (rowid, lk_vector) VALUES ((SELECT "lk_row" FROM "posts_lk_vec_meaning_rows" WHERE "id" = new."id"), new."meaning");
END;

CREATE TRIGGER "posts_lk_vec_meaning_update_null" AFTER UPDATE OF "meaning", "id" ON "posts" WHEN new."meaning" IS NULL BEGIN
	DELETE FROM "posts_lk_vec_meaning" WHERE rowid = (SELECT "lk_row" FROM "posts_lk_vec_meaning_rows" WHERE "id" = old."id");
	UPDATE "posts_lk_vec_meaning_rows" SET "id" = new."id" WHERE "id" = old."id";
END;

CREATE TRIGGER "posts_lk_vec_meaning_update" AFTER UPDATE OF "meaning", "id" ON "posts" WHEN new."meaning" IS NOT NULL BEGIN
	DELETE FROM "posts_lk_vec_meaning" WHERE rowid = (SELECT "lk_row" FROM "posts_lk_vec_meaning_rows" WHERE "id" = old."id");
	UPDATE "posts_lk_vec_meaning_rows" SET "id" = new."id" WHERE "id" = old."id";
	INSERT INTO "posts_lk_vec_meaning" (rowid, lk_vector) VALUES ((SELECT "lk_row" FROM "posts_lk_vec_meaning_rows" WHERE "id" = new."id"), new."meaning");
END;

CREATE TRIGGER "posts_lk_vec_meaning_delete" AFTER DELETE ON "posts" BEGIN
	DELETE FROM "posts_lk_vec_meaning" WHERE rowid = (SELECT "lk_row" FROM "posts_lk_vec_meaning_rows" WHERE "id" = old."id");
	DELETE FROM "posts_lk_vec_meaning_rows" WHERE "id" = old."id";
END;

UPDATE "posts" SET "lk_meaning_source" = lk_sha256(coalesce(octet_length("title") || ':' || "title", '-') || ';') WHERE "meaning" IS NOT NULL AND "lk_meaning_source" IS NULL;

CREATE TRIGGER "posts_lk_meaning_source_insert" AFTER INSERT ON "posts" WHEN new."lk_meaning_source" IS NULL AND new."meaning" IS NOT NULL BEGIN
	UPDATE "posts" SET "lk_meaning_source" = lk_sha256(coalesce(octet_length(new."title") || ':' || new."title", '-') || ';') WHERE "id" = new."id";
END;

CREATE TRIGGER "posts_lk_meaning_source_update" AFTER UPDATE OF "meaning" ON "posts" WHEN new."meaning" IS NOT old."meaning" AND new."lk_meaning_source" IS old."lk_meaning_source" BEGIN
	UPDATE "posts" SET "lk_meaning_source" = CASE WHEN new."meaning" IS NULL THEN NULL ELSE lk_sha256(coalesce(octet_length(new."title") || ':' || new."title", '-') || ';') END WHERE "id" = new."id";
END;
