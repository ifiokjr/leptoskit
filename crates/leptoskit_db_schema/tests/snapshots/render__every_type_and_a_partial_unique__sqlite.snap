CREATE TABLE "events" (
	"id" BLOB NOT NULL CHECK (length("id") = 16),
	"slug" TEXT NOT NULL CHECK (length("slug") <= 40),
	"public" INTEGER NOT NULL DEFAULT 1 CHECK ("public" IN (0, 1)),
	"seats" INTEGER NOT NULL DEFAULT 10 CHECK ("seats" BETWEEN -32768 AND 32767),
	"ratio" REAL,
	"weight" REAL NOT NULL DEFAULT 1.5,
	"price" TEXT,
	"cover" BLOB,
	"details" TEXT CHECK (json_valid("details")),
	"starts_on" TEXT NOT NULL,
	"created_at" TEXT NOT NULL DEFAULT (strftime('%Y-%m-%dT%H:%M:%fZ', 'now')),
	"deleted_at" TEXT,
	CONSTRAINT "events_pkey" PRIMARY KEY ("id")
) STRICT;

CREATE UNIQUE INDEX "events_slug_key" ON "events" ("slug") WHERE "deleted_at" IS NULL;
