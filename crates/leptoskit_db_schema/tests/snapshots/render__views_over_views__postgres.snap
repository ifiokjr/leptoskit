-- @generated by leptoskit db. Edits are allowed: the migration is applied as written, and schema.json beside it records the schema it produces.
-- dialect: postgres

CREATE SCHEMA IF NOT EXISTS "reports";

CREATE VIEW "post_counts" ("author_id", "posts") AS
SELECT author_id, count(*) FROM posts GROUP BY author_id;

COMMENT ON VIEW "post_counts" IS 'Posts per author.';

CREATE VIEW "busy_authors" ("author_id") AS
SELECT author_id FROM post_counts WHERE posts > 1;

CREATE MATERIALIZED VIEW "published_posts" ("id", "title") AS
SELECT id, title FROM posts WHERE status = 'published';

COMMENT ON MATERIALIZED VIEW "published_posts" IS 'Published posts, as of the last refresh.';

CREATE UNIQUE INDEX "published_posts_id_key" ON "published_posts" ("id");

CREATE INDEX "published_posts_title_idx" ON "published_posts" ("title");

CREATE VIEW "reports"."long_titles" ("id") AS
SELECT id FROM posts WHERE char_length(title) > 4;
