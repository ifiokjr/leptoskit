	"body" TEXT,
	"score" INTEGER NOT NULL DEFAULT 0 CHECK ("score" BETWEEN -2147483648 AND 2147483647),
	"status" TEXT NOT NULL DEFAULT 'draft',
	CONSTRAINT "posts_pkey" PRIMARY KEY ("id"),
	CONSTRAINT "posts_author_id_fkey" FOREIGN KEY ("author_id") REFERENCES "users" ("id") ON DELETE CASCADE,
	CONSTRAINT "posts_score_check" CHECK ("score" >= 0 AND "score" <= 100),
