	CONSTRAINT "tags_pkey" PRIMARY KEY ("post_id"),
	CONSTRAINT "tags_post_id_fkey" FOREIGN KEY ("post_id") REFERENCES "posts" ("id") ON DELETE CASCADE
) STRICT;

