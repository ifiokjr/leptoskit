	"id" INTEGER NOT NULL,
	"handle" TEXT NOT NULL CHECK (length("handle") <= 32),
	"display_name" TEXT NOT NULL,
	"created_at" TEXT NOT NULL,
	CONSTRAINT "users_pkey" PRIMARY KEY ("id")
