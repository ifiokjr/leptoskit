-- @generated by leptoskit db. Edits are allowed: the migration is applied as written, and schema.json beside it records the schema it produces.
-- dialect: postgres

DROP VIEW "busy_authors";

DROP VIEW "post_counts";

CREATE VIEW "post_counts" ("author_id", "posts") AS
SELECT author_id, count(*) * 2 FROM posts GROUP BY author_id;

COMMENT ON VIEW "post_counts" IS 'Posts per author.';

CREATE VIEW "busy_authors" ("author_id") AS
SELECT author_id FROM post_counts WHERE posts > 1;
