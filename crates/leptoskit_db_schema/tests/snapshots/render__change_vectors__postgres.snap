UPDATE "posts" SET "lk_meaning_source" = encode(sha256(convert_to(coalesce(octet_length("title")::text || ':' || "title", '-') || ';', 'UTF8')), 'hex') WHERE "meaning" IS NOT NULL AND "lk_meaning_source" IS NULL;

CREATE FUNCTION "posts_lk_meaning_source"() RETURNS trigger LANGUAGE plpgsql AS $lk$
BEGIN
	IF TG_OP = 'INSERT' THEN
		IF NEW."lk_meaning_source" IS NULL AND NEW."meaning" IS NOT NULL THEN
			NEW."lk_meaning_source" := encode(sha256(convert_to(coalesce(octet_length(NEW."title")::text || ':' || NEW."title", '-') || ';', 'UTF8')), 'hex');
		END IF;
	ELSIF NEW."meaning" IS DISTINCT FROM OLD."meaning" AND NEW."lk_meaning_source" IS NOT DISTINCT FROM OLD."lk_meaning_source" THEN
		NEW."lk_meaning_source" := CASE WHEN NEW."meaning" IS NULL THEN NULL ELSE encode(sha256(convert_to(coalesce(octet_length(NEW."title")::text || ':' || NEW."title", '-') || ';', 'UTF8')), 'hex') END;
	END IF;
	RETURN NEW;
END
$lk$;

CREATE TRIGGER "posts_lk_meaning_source" BEFORE INSERT OR UPDATE OF "meaning" ON "posts" FOR EACH ROW EXECUTE FUNCTION "posts_lk_meaning_source"();

