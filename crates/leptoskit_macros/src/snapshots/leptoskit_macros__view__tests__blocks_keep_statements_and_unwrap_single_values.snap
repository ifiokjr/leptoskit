---
source: crates/leptoskit_macros/src/view.rs
expression: "pretty(expand(quote!\n{\n    <View class={classes}> { let label = name.clone(); label } {(a, b)}\n    </View>\n}))"
---
fn view() {
    {
        #[allow(unused_imports)]
        use ::leptoskit::__private::BuildView as _;
        View::builder()
            .class(classes)
            .children(
                ::leptoskit::Fragment::new()
                    .with({
                        let label = name.clone();
                        label
                    })
                    .with((a, b)),
            )
            .build()
    }
}
