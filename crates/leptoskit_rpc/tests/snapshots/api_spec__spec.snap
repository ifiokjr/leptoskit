---
source: crates/leptoskit_rpc/tests/api_spec.rs
expression: spec
---
{
  "leptoskit_rpc_spec": 1,
  "title": "Todos",
  "version": "1.2.3",
  "description": null,
  "servers": [
    "https://todos.example"
  ],
  "functions": [
    {
      "name": "create_todo",
      "module_path": "api_spec",
      "struct_name": "CreateTodo",
      "docs": "Creates a todo.",
      "path": "/api/create_todo",
      "method": "POST",
      "input": "Json",
      "output": "Json",
      "error_content_type": "text/plain",
      "params": [
        {
          "name": "title",
          "docs": "What needs doing.",
          "schema": {
            "type": "string"
          },
          "required": true
        },
        {
          "name": "tags",
          "docs": "",
          "schema": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "required": false
        }
      ],
      "output_schema": {
        "$ref": "#/components/schemas/Todo"
      },
      "internal": false,
      "deprecated": false,
      "tags": [
        "todos"
      ]
    },
    {
      "name": "events_since",
      "module_path": "api_spec",
      "struct_name": "OldEvents",
      "docs": "Events since a point in time.",
      "path": "/v1/events",
      "method": "POST",
      "input": "Form",
      "output": "Json",
      "error_content_type": "text/plain",
      "params": [
        {
          "name": "since",
          "docs": "",
          "schema": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "required": true
        }
      ],
      "output_schema": {
        "items": {
          "$ref": "#/components/schemas/Event"
        },
        "type": "array"
      },
      "internal": false,
      "deprecated": true,
      "tags": [
        "events",
        "legacy"
      ]
    },
    {
      "name": "flush_caches",
      "module_path": "api_spec",
      "struct_name": "FlushCaches",
      "docs": "Flushes caches. For operators only.",
      "path": "/api/flush_caches",
      "method": "POST",
      "input": "Form",
      "output": "Json",
      "error_content_type": "text/plain",
      "params": [],
      "output_schema": {
        "type": "null"
      },
      "internal": true,
      "deprecated": false,
      "tags": []
    },
    {
      "name": "get_todo",
      "module_path": "api_spec",
      "struct_name": "GetTodo",
      "docs": "Reads one todo.",
      "path": "/api/get_todo",
      "method": "GET",
      "input": "Query",
      "output": "Json",
      "error_content_type": "text/plain",
      "params": [
        {
          "name": "id",
          "docs": "",
          "schema": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "required": true
        }
      ],
      "output_schema": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/Todo"
          },
          {
            "type": "null"
          }
        ]
      },
      "internal": false,
      "deprecated": false,
      "tags": []
    },
    {
      "name": "legacy_ping",
      "module_path": "api_spec",
      "struct_name": "LegacyPing",
      "docs": "The legacy positional `#[server]` form keeps its own route.",
      "path": "/legacy/ping",
      "method": "GET",
      "input": "Query",
      "output": "Json",
      "error_content_type": "text/plain",
      "params": [],
      "output_schema": {
        "format": "uint8",
        "maximum": 255,
        "minimum": 0,
        "type": "integer"
      },
      "internal": false,
      "deprecated": false,
      "tags": []
    },
    {
      "name": "list_todos",
      "module_path": "api_spec",
      "struct_name": "ListTodos",
      "docs": "Lists todos.\n\nNewest first.",
      "path": "/api/list_todos",
      "method": "POST",
      "input": "Form",
      "output": "Json",
      "error_content_type": "text/plain",
      "params": [
        {
          "name": "filter",
          "docs": "Which todos to list.",
          "schema": {
            "$ref": "#/components/schemas/TodoFilter"
          },
          "required": true
        },
        {
          "name": "limit",
          "docs": "How many to return.",
          "schema": {
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "required": true
        }
      ],
      "output_schema": {
        "items": {
          "$ref": "#/components/schemas/Todo"
        },
        "type": "array"
      },
      "internal": false,
      "deprecated": false,
      "tags": [
        "todos"
      ]
    }
  ],
  "schemas": {
    "Event": {
      "description": "Something that happened to a todo.",
      "oneOf": [
        {
          "properties": {
            "id": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "created",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "deleted",
              "type": "string"
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        }
      ]
    },
    "Todo": {
      "description": "One todo item.",
      "properties": {
        "done": {
          "description": "Whether it is done.",
          "type": "boolean"
        },
        "id": {
          "description": "The identifier.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "tags": {
          "default": [],
          "description": "Free-form labels.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "title": {
          "description": "What to do.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "done"
      ],
      "type": "object"
    },
    "TodoFilter": {
      "description": "Which todos to list.",
      "enum": [
        "all",
        "done",
        "pending"
      ],
      "type": "string"
    }
  }
}
