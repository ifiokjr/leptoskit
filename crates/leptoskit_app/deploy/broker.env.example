# Install the completed file as root:root, mode 0600, outside the release.
# systemd reads this file; it is not a shell script.
LEPTOSKIT_PUBLIC_ORIGIN=https://pilot.example.com
# Empty credentials deliberately fail startup. Fill only the private copy.
LEPTOSKIT_HOSTED_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONTROL_PRICE=
STRIPE_TEAM_PRICE=
