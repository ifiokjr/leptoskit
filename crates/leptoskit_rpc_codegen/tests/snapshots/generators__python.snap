# Generated by `leptoskit rpc generate` from Todos 1.2.3. Do not edit; regenerate instead.
"""Types for the Todos 1.2.3 RPC."""

from __future__ import annotations

from typing import Any, Literal, NotRequired, Optional, Required, TypeAlias, TypedDict, Union

class Todo(TypedDict, total=False):
	"""One todo item."""
	# Whether it is done.
	done: Required[bool]
	id: Required[int]
	# Free-form labels.
	tags: NotRequired[list[str]]
	title: Required[str]

Counts: TypeAlias = "dict[str, int]"

# Which todos to list.
TodoFilter: TypeAlias = "Literal[\"all\", \"done\", \"pending\"]"


===== todos_api/client.py (Code) =====
# Generated by `leptoskit rpc generate` from Todos 1.2.3. Do not edit; regenerate instead.
"""A typed client for the Todos 1.2.3 RPC."""

from __future__ import annotations

import json
import urllib.error
import urllib.parse
import urllib.request
from typing import Any, Mapping, Optional

from .models import Counts, Todo, TodoFilter

DEFAULT_SERVER_URL = "https://todos.example"
"""The server origin baked in at generation time; empty means same origin."""


class FnError(Exception):
    """A failed RPC call, classified like ``leptoskit_rpc::FnError``.

    ``kind`` is one of ``network``, ``invalid``, ``server``, ``decode``, or ``other``.
    """

    def __init__(
        self,
        kind: str,
        message: str,
        *,
        status: Optional[int] = None,
        raw: Optional[str] = None,
    ) -> None:
        super().__init__(message)
        self.kind = kind
        self.message = message
        self.status = status
        self.raw = raw

    @property
    def retryable(self) -> bool:
        """Whether retrying the call could plausibly succeed: only when no answer arrived.

        Server errors are final: the server reports a refusal such as "not found" the same way
        as an outage.
        """
        return self.kind == "network"

    @classmethod
    def from_response(cls, status: int, body: str) -> "FnError":
        """Parses leptos's error body: ``Kind|message`` as ``text/plain``."""
        variant, separator, message = body.partition("|")
        if not separator:
            return cls("other", body or f"HTTP {status}", status=status, raw=body)
        kind = _ERROR_KINDS.get(variant, "other")
        return cls(kind, message, status=status, raw=body)


_ERROR_KINDS = {
    "Request": "network",
    "Args": "invalid",
    "MissingArg": "invalid",
    "ServerError": "server",
    "MiddlewareError": "server",
    "WrappedServerFn": "server",
    "Deserialization": "decode",
    "Serialization": "decode",
}


def to_query_string(value: Mapping[str, Any]) -> str:
    """Encodes a value the way ``serde_qs`` does.

    Nested keys go in brackets, lists by index, and ``None`` is omitted.
    """
    pairs: list[tuple[str, str]] = []

    def append(key: str, item: Any) -> None:
        if item is None:
            return
        if isinstance(item, bool):
            pairs.append((key, "true" if item else "false"))
        elif isinstance(item, (list, tuple)):
            for index, entry in enumerate(item):
                append(f"{key}[{index}]", entry)
        elif isinstance(item, Mapping):
            for field, entry in item.items():
                append(f"{key}[{field}]", entry)
        else:
            pairs.append((key, str(item)))

    for key, item in value.items():
        append(key, item)
    return urllib.parse.urlencode(pairs)


def _decode(status: int, body: str) -> Any:
    if body == "":
        return None
    try:
        return json.loads(body)
    except ValueError as error:
        raise FnError("decode", f"the response was not JSON: {error}", status=status, raw=body) from error


class _BaseClient:
    def __init__(
        self,
        base_url: str = DEFAULT_SERVER_URL,
        *,
        headers: Optional[Mapping[str, str]] = None,
        timeout: float = 30.0,
    ) -> None:
        self.base_url = base_url.rstrip("/")
        self.headers = dict(headers or {})
        self.timeout = timeout

    def _prepare(
        self, method: str, path: str, encoding: str, payload: Mapping[str, Any]
    ) -> tuple[str, dict[str, str], Optional[bytes]]:
        url = f"{self.base_url}{path}"
        headers = {"Accept": "application/json", **self.headers}
        data: Optional[bytes] = None
        if encoding == "query":
            query = to_query_string(payload)
            if query:
                url += ("&" if "?" in url else "?") + query
        elif encoding == "form":
            headers["Content-Type"] = "application/x-www-form-urlencoded"
            data = to_query_string(payload).encode("utf-8")
        else:
            headers["Content-Type"] = "application/json"
            # Absent optional arguments are omitted, as `serde_qs` omits them.
            present = {key: item for key, item in payload.items() if item is not None}
            data = json.dumps(present).encode("utf-8")
        return url, headers, data


class Client(_BaseClient):
	"""A synchronous client over the standard library.

	Pass ``server_url`` to point it at a server, ``headers`` for authorization, and
	``timeout`` in seconds.
	"""

	def _call(self, method: str, path: str, encoding: str, payload: Mapping[str, Any]) -> Any:
		url, headers, data = self._prepare(method, path, encoding, payload)
		request = urllib.request.Request(url, data=data, method=method, headers=headers)
		try:
			with urllib.request.urlopen(request, timeout=self.timeout) as response:
				status = response.status
				body = response.read().decode("utf-8")
		except urllib.error.HTTPError as error:
			body = error.read().decode("utf-8", "replace")
			raise FnError.from_response(error.code, body) from error
		except urllib.error.URLError as error:
			raise FnError("network", f"could not reach {url}: {error.reason}") from error
		return _decode(status, body)

	def list_todos(self, *, filter: TodoFilter, limit: Optional[int] = None) -> list[Todo]:
		"""Lists todos.

		Newest first.

		Arguments:
			filter: Which todos to list.
			limit: How many to return.
		"""
		return self._call("POST", "/api/list_todos", "form", {"filter": filter, "limit": limit})

	def create_todo(self, *, title: str, tags: Optional[list[str]] = None) -> Todo:
		"""Creates a todo.

		Arguments:
			title: What needs doing.
		"""
		return self._call("POST", "/api/create_todo", "json", {"title": title, "tags": tags})

	def get_todo(self, *, id: int) -> Optional[Todo]:
		"""Reads one todo."""
		return self._call("GET", "/api/get_todo", "query", {"id": id})

	def counts(self) -> Counts:
		"""

		Deprecated.
		"""
		return self._call("POST", "/api/counts", "form", {})


class AsyncClient(_BaseClient):
	"""An asynchronous client over ``httpx`` (install the ``async`` extra).

	Pass an existing ``httpx.AsyncClient`` as ``http`` to share connections.
	"""

	def __init__(
		self,
		base_url: str = DEFAULT_SERVER_URL,
		*,
		headers: Optional[Mapping[str, str]] = None,
		timeout: float = 30.0,
		http: Any = None,
	) -> None:
		super().__init__(base_url, headers=headers, timeout=timeout)
		if http is None:
			try:
				import httpx
			except ImportError as error:  # pragma: no cover
				raise ImportError(
					"AsyncClient needs httpx; install the async extra or pass http="
				) from error
			http = httpx.AsyncClient(timeout=timeout)
		self.http = http

	async def aclose(self) -> None:
		"""Closes the underlying ``httpx`` client."""
		await self.http.aclose()

	async def __aenter__(self) -> "AsyncClient":
		return self

	async def __aexit__(self, *exc_info: object) -> None:
		await self.aclose()

	async def _call(self, method: str, path: str, encoding: str, payload: Mapping[str, Any]) -> Any:
		url, headers, data = self._prepare(method, path, encoding, payload)
		try:
			response = await self.http.request(method, url, headers=headers, content=data)
		except Exception as error:  # httpx.TransportError and friends
			raise FnError("network", f"could not reach {url}: {error}") from error
		if response.status_code >= 400:
			raise FnError.from_response(response.status_code, response.text)
		return _decode(response.status_code, response.text)

	async def list_todos(self, *, filter: TodoFilter, limit: Optional[int] = None) -> list[Todo]:
		"""Lists todos.

		Newest first.

		Arguments:
			filter: Which todos to list.
			limit: How many to return.
		"""
		return await self._call("POST", "/api/list_todos", "form", {"filter": filter, "limit": limit})

	async def create_todo(self, *, title: str, tags: Optional[list[str]] = None) -> Todo:
		"""Creates a todo.

		Arguments:
			title: What needs doing.
		"""
		return await self._call("POST", "/api/create_todo", "json", {"title": title, "tags": tags})

	async def get_todo(self, *, id: int) -> Optional[Todo]:
		"""Reads one todo."""
		return await self._call("GET", "/api/get_todo", "query", {"id": id})

	async def counts(self) -> Counts:
		"""

		Deprecated.
		"""
		return await self._call("POST", "/api/counts", "form", {})

===== README.md (Scaffold) =====
# todos-api

A typed Python client for the **Todos 1.2.3** RPC, generated by `leptoskit rpc generate --target python`.

The synchronous `Client` uses only the standard library; `AsyncClient` needs the `async` extra (`pip install 'todos-api[async]'`), which brings in `httpx`. Models are `TypedDict`s, so values are plain dictionaries, and the calls go to the same routes the app itself uses.

## Usage

```python
from todos_api import Client, FnError

api = Client("https://todos.example")

try:
    result = api.list_todos(filter=...)
except FnError as error:
    if error.retryable:
        ...  # a network or server failure: safe to try again
    raise
```

```python
from todos_api import AsyncClient

async with AsyncClient("https://todos.example") as api:
    result = api.list_todos(filter=...)
```

`FnError.kind` is one of `network`, `invalid`, `server`, `decode`, or `other`, mirroring the server's classification; `retryable` is true only for `network`.
