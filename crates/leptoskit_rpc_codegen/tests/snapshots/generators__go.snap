// Generated by `leptoskit rpc generate` from Todos 1.2.3. Do not edit; regenerate instead.
// Code generated by leptoskit; DO NOT EDIT.

package todos

// Types for the Todos 1.2.3 RPC.

// One todo item.
type Todo struct {
	// Whether it is done.
	Done  bool     `json:"done"`
	Id    uint64   `json:"id"`
	// Free-form labels.
	Tags  []string `json:"tags,omitempty"`
	Title string   `json:"title"`
}

// Which todos to list.
type TodoFilter string

const (
	TodoFilterAll     TodoFilter = "all"
	TodoFilterDone    TodoFilter = "done"
	TodoFilterPending TodoFilter = "pending"
)

type Counts = map[string]int64


