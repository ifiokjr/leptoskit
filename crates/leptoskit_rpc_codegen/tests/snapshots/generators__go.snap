// id is The todo.
// 
// Pass a context from WithIdempotencyKey to make a retried call run once.
func (c *Client) CompleteTodo(ctx context.Context, id uint64) (Todo, error) {
	var result Todo
	if err := c.callInto(ctx, "POST", "/api/complete_todo", "json", struct {
