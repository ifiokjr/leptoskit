// title is What needs doing.
func (c *Client) CreateTodo(ctx context.Context, title string, tags []string) (Todo, error) {
	var result Todo
	if err := c.callInto(ctx, "POST", "/api/create_todo", "json", struct {
	Title string   `json:"title"`
	Tags  []string `json:"tags,omitempty"`
	}{Title: title, Tags: tags}, &result); err != nil {
		var zero Todo
		return zero, err
