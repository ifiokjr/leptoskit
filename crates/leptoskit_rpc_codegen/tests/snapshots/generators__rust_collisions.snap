// Generated by `leptoskit rpc generate` from Clash 0.0.1. Do not edit; regenerate instead.
//! The transport: one method per published function.

use crate::models::*;
#[cfg(feature = "live")]
use crate::live;
use serde::Serialize;
use serde::de::DeserializeOwned;

/// The server origin baked in at generation time.
pub const DEFAULT_SERVER_URL: &str = "https://example.com";

/// Where the server serves the live connection, relative to its origin.
pub const LIVE_PATH: &str = "/live";

#[derive(Serialize)]
struct CallInput {
	/// Ends the comment */ early, then /* opens one.
	ctx: String,
	#[serde(rename = "self")]
	self_: bool,
	result: i64,
	server_url: String,
}

#[derive(Serialize)]
struct NewInput {
	value: Record,
}

#[derive(Serialize)]
struct ListTodosInput2 {
	filter: Command,
	option: Option2,
}

/// How a failed call is classified, mirroring `leptoskit_rpc::FnError`.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum FnErrorKind {
	/// The request never arrived or was dropped.
	Network,
	/// The server rejected the arguments.
	Invalid,
	/// The function failed while running.
	Server,
	/// A response that wouldn't parse.
	Decode,
	/// Everything else.
	Other,
}

impl FnErrorKind {
	/// Whether retrying could plausibly succeed: only when no answer arrived.
	/// Server errors are final, because the server reports a refusal such as
	/// "not found" the same way as an outage.
	pub fn retryable(self) -> bool {
		matches!(self, Self::Network)
	}
}

/// A failed call.
#[derive(Debug, thiserror::Error)]
pub enum Error {
	/// The RPC answered with an error.
	#[error("{kind:?} error: {message}")]
	Fn {
		/// The classification.
		kind: FnErrorKind,
		/// The human-readable message.
		message: String,
	},
	/// The transport failed before or after the call.
	#[error("transport error: {0}")]
	Transport(#[source] reqwest::Error),
	/// The response was not the JSON the schema promised.
	#[error("decode error: {0}")]
	Decode(#[source] serde_json::Error),
}

/// How a request body is encoded.
// A spec whose functions all speak JSON never builds the others.
#[allow(dead_code)]
#[derive(Clone, Copy)]
enum Encoding {
	Query,
	Form,
	Json,
}

/// A typed client for the RPC.
#[derive(Debug, Clone)]
pub struct Client {
	server_url: String,
	http: reqwest::Client,
	headers: reqwest::header::HeaderMap,
	#[cfg(feature = "live")]
	live_options: live::LiveOptions,
	/// Opened on first use, and shared by the clones.
	#[cfg(feature = "live")]
	live: std::sync::Arc<std::sync::OnceLock<live::LiveConnection>>,
}

impl Default for Client {
	fn default() -> Self {
		Self::new()
	}
}

impl Client {
	/// A client for [`DEFAULT_SERVER_URL`].
	pub fn new() -> Self {
		Self {
			server_url: DEFAULT_SERVER_URL.trim_end_matches('/').to_owned(),
			http: reqwest::Client::new(),
			headers: reqwest::header::HeaderMap::new(),
			#[cfg(feature = "live")]
			live_options: live::LiveOptions::default(),
			#[cfg(feature = "live")]
			live: std::sync::Arc::default(),
		}
	}

	/// A client for `server_url`, an origin such as `https://api.example.com`.
	pub fn with_server_url(server_url: impl Into<String>) -> Self {
		Self {
			server_url: server_url.into().trim_end_matches('/').to_owned(),
			..Self::new()
		}
	}

	/// Sets a header sent with every request, such as `Authorization`, and
	/// with the live connection's upgrade request.
	pub fn with_header(
		mut self,
		name: reqwest::header::HeaderName,
		value: reqwest::header::HeaderValue,
	) -> Self {
		self.headers.insert(name, value);
		#[cfg(feature = "live")]
		{
			// The connection's identity changed: it opens its own.
			self.live = std::sync::Arc::default();
		}
		self
	}

	/// The origin this client sends requests to.
	pub fn server_url(&self) -> &str {
		&self.server_url
	}

	/// A copy of this client that sends `key` as the `Idempotency-Key` of
	/// every call, and as the key of every live call. Calling a mutation
	/// again with the same key and arguments returns the first call's result
	/// instead of running it twice, so a call whose answer was lost is safe to
	/// retry. Use a fresh key, such as a UUID, for each new call.
	pub fn with_idempotency_key(&self, key: reqwest::header::HeaderValue) -> Self {
		let mut client = self.clone();
		client.headers.insert("idempotency-key", key);
		client
	}

	async fn exchange(
		&self,
		method: &str,
		path: &str,
		encoding: Encoding,
		payload: &impl Serialize,
	) -> Result<reqwest::Response, Error> {
		let mut url = format!("{}{}", self.server_url, path);
		let request = match encoding {
			Encoding::Query => {
				let query = serde_qs::to_string(payload)
					.map_err(|error| Error::Fn { kind: FnErrorKind::Invalid, message: error.to_string() })?;
				if !query.is_empty() {
					url.push(if url.contains('?') { '&' } else { '?' });
					url.push_str(&query);
				}
				self.http.request(reqwest::Method::from_bytes(method.as_bytes()).expect("a known method"), &url)
			}
			Encoding::Form => {
				let body = serde_qs::to_string(payload)
					.map_err(|error| Error::Fn { kind: FnErrorKind::Invalid, message: error.to_string() })?;
				self.http
					.request(reqwest::Method::from_bytes(method.as_bytes()).expect("a known method"), &url)
					.header(reqwest::header::CONTENT_TYPE, "application/x-www-form-urlencoded")
					.body(body)
			}
			Encoding::Json => {
				// Absent optional arguments are omitted, as `serde_qs` omits
				// them: the server fills defaulted arguments in, and `Option`
				// arguments read a missing key as `None`.
				let encoded = serde_json::to_value(payload)
					.map_err(|error| Error::Fn { kind: FnErrorKind::Invalid, message: error.to_string() })?;
				let present = match encoded {
					serde_json::Value::Object(fields) => serde_json::Value::Object(
						fields
							.into_iter()
							.filter(|(_, item)| !item.is_null())
							.collect(),
					),
					other => other,
				};
				self.http
					.request(reqwest::Method::from_bytes(method.as_bytes()).expect("a known method"), &url)
					.header(reqwest::header::CONTENT_TYPE, "application/json")
					.body(present.to_string())
			}
		};
		self.finish(request).await
	}

	async fn finish(
		&self,
		mut request: reqwest::RequestBuilder,
	) -> Result<reqwest::Response, Error> {
		request = request
			.headers(self.headers.clone())
			.header(reqwest::header::ACCEPT, "application/json");
		let response = request.send().await.map_err(Error::Transport)?;
		let status = response.status();
		if status.is_client_error() || status.is_server_error() {
			let body = response.text().await.map_err(Error::Transport)?;
			return Err(classify(status.as_u16(), &body));
		}
		Ok(response)
	}

	async fn call<T: DeserializeOwned>(
		&self,
		method: &str,
		path: &str,
		encoding: Encoding,
		payload: &impl Serialize,
	) -> Result<T, Error> {
		let response = self.exchange(method, path, encoding, payload).await?;
		let text = response.text().await.map_err(Error::Transport)?;
		serde_json::from_str(&text).map_err(Error::Decode)
	}

	// A spec without a function that returns nothing never calls it.
	#[allow(dead_code)]
	async fn call_void(
		&self,
		method: &str,
		path: &str,
		encoding: Encoding,
		payload: &impl Serialize,
	) -> Result<(), Error> {
		self.exchange(method, path, encoding, payload).await?;
		Ok(())
	}
}

/// Parses the server's `Kind|message` error text.
fn classify(_status: u16, body: &str) -> Error {
	let (kind, message) = match body.split_once('|') {
		Some(("Request", message)) => (FnErrorKind::Network, message.to_owned()),
		Some(("Args" | "MissingArg", message)) => (FnErrorKind::Invalid, message.to_owned()),
		Some(("ServerError" | "MiddlewareError" | "WrappedServerFn", message)) => {
			(FnErrorKind::Server, message.to_owned())
		}
		Some(("Deserialization" | "Serialization", message)) => {
			(FnErrorKind::Decode, message.to_owned())
		}
		_ => (FnErrorKind::Other, body.to_owned()),
	};
	Error::Fn { kind, message }
}

impl Client {
	/// # Arguments
	///
	/// * `ctx` — Ends the comment */ early, then /* opens one.
	pub async fn call2(&self, ctx: String, self_: bool, result: i64, server_url: String) -> Result<Client2, Error> {
		self.call("POST", "/api/call", Encoding::Form, &CallInput { ctx, self_, result, server_url }).await
	}

	pub async fn headers(&self) -> Result<Error2, Error> {
		self.call("POST", "/api/headers", Encoding::Form, &serde_json::json!({})).await
	}

	pub async fn new2(&self, value: Record) -> Result<Encoding2, Error> {
		self.call("POST", "/api/new", Encoding::Form, &NewInput { value }).await
	}

	pub async fn list_todos(&self, filter: Command, option: Option2) -> Result<ListTodosInput, Error> {
		self.call("POST", "/api/list_todos", Encoding::Form, &ListTodosInput2 { filter, option }).await
	}

	pub async fn to_string(&self) -> Result<(), Error> {
		self.call_void("POST", "/api/to_string", Encoding::Form, &serde_json::json!({})).await
	}

}

#[cfg(feature = "live")]
impl Client {
	/// A copy of this client whose live connection uses `options`: its token,
	/// its read-your-writes wait, and its backoff. The copy opens its own
	/// connection.
	pub fn with_live_options(mut self, options: live::LiveOptions) -> Self {
		self.live_options = options;
		self.live = std::sync::Arc::default();
		self
	}

	/// A copy of this client whose live connection signs in with the bearer
	/// token `token` returns, such as a native session's access token. It's
	/// called on every connect, and again when the server says the token is
	/// about to expire.
	pub fn with_live_token(self, token: impl Fn() -> Option<String> + Send + Sync + 'static) -> Self {
		let options = self.live_options.clone().token(token);
		self.with_live_options(options)
	}

	/// The live connection: one WebSocket to the server's [`LIVE_PATH`] for
	/// every subscription, live call and channel, opened on first use and
	/// shared by this client's clones. Make live calls from inside a Tokio
	/// runtime.
	pub fn live(&self) -> &live::LiveConnection {
		self.live.get_or_init(|| {
			let origin = match self.server_url.strip_prefix("http") {
				Some(rest) => format!("ws{rest}"),
				None => self.server_url.clone(),
			};
			let headers = self
				.headers
				.iter()
				.filter(|(name, _)| name.as_str() != "idempotency-key")
				.filter_map(|(name, value)| Some((name.as_str().to_owned(), value.to_str().ok()?.to_owned())))
				.collect();
			live::LiveConnection::new(format!("{origin}{LIVE_PATH}"), headers, self.live_options.clone())
		})
	}

	/// Where the live connection is, now and as it changes, for a
	/// "reconnecting…" banner.
	pub fn live_status(&self) -> tokio::sync::watch::Receiver<live::LiveStatus> {
		self.live().watch_status()
	}

}

