// Generated by `leptoskit rpc generate` from Todos 1.2.3. Do not edit; regenerate instead.
import { channelKey, LiveConnection, liveUrl } from "./live.ts";
import type { ChannelHandle, JoinOptions, LiveError, LiveOptions, Unsubscribe } from "./live.ts";

export * from "./live.ts";

export type Counts = Record<string, number>;

/** Something that happened to a todo. */
export type Event = { id: number; kind: "created" } | { id: number; kind: "deleted"; reason?: string | null };

/** One todo item. */
export interface Todo {
	/** Whether it is done. */
	done: boolean;
	id: number;
	/** Free-form labels. */
	tags?: string[];
	title: string;
}

/** Which todos to list. */
export type TodoFilter = "all" | "done" | "pending";

/** One todo list's room. */
export interface TodoRoom {
	filter: TodoFilter;
	list: number;
}

/** What a member of a room shows the others. */
export interface Viewer {
	name: string;
}

/** How a failed call is classified, mirroring `leptoskit_rpc::FnError`. */
export type FnErrorKind = "network" | "invalid" | "server" | "decode" | "other";

/** A failed RPC call. */
export class FnError extends Error {
	/** The classification. */
	readonly kind: FnErrorKind;
	/** The HTTP status, when a response arrived. */
	readonly status: number | undefined;
	/** The raw response body, when a response arrived. */
	readonly raw: string | undefined;

	constructor(
		kind: FnErrorKind,
		message: string,
		options: { status?: number; raw?: string; cause?: unknown } = {},
	) {
		super(message, options.cause === undefined ? undefined : { cause: options.cause });
		this.name = "FnError";
		this.kind = kind;
		this.status = options.status;
		this.raw = options.raw;
	}

	/**
	 * Whether retrying the call could plausibly succeed: only when no answer
	 * arrived. Server errors are final, because the server reports a refusal
	 * such as "not found" the same way as an outage.
	 */
	get retryable(): boolean {
		return this.kind === "network";
	}

	/**
	 * Parses leptos's error body: `Kind|message` as `text/plain`, where `Kind`
	 * is one of the `ServerFnError` variants.
	 */
	static fromResponse(status: number, body: string): FnError {
		const separator = body.indexOf("|");
		if (separator === -1) {
			return new FnError("other", body || `HTTP ${status}`, { status, raw: body });
		}
		const variant = body.slice(0, separator);
		const message = body.slice(separator + 1);
		let kind: FnErrorKind;
		switch (variant) {
			case "Request":
				kind = "network";
				break;
			case "Args":
			case "MissingArg":
				kind = "invalid";
				break;
			case "ServerError":
			case "MiddlewareError":
			case "WrappedServerFn":
				kind = "server";
				break;
			case "Deserialization":
			case "Serialization":
				kind = "decode";
				break;
			default:
				kind = "other";
		}
		return new FnError(kind, message, { status, raw: body });
	}
}

/** Options for a `Client`. */
export interface ClientOptions {
	/** The origin the RPC is served from, without a trailing slash. Defaults to the page's own origin. */
	serverUrl?: string;
	/** Headers sent with every request, such as `Authorization`. */
	headers?: Record<string, string>;
	/** The `fetch` implementation to use; defaults to the global one. */
	fetch?: typeof fetch;
	/** How the live connection signs in and reconnects. */
	live?: LiveOptions;
}

/** Options for one call. */
export interface CallOptions {
	/**
	 * Any unique string, such as `crypto.randomUUID()`. Sending a mutation again
	 * with the same key and arguments returns the first call's result instead of
	 * running it twice, so a call whose answer was lost is safe to retry.
	 */
	idempotencyKey?: string;
}

/** How a request body is encoded; chosen per function by the server's codec. */
type Encoding = "query" | "form" | "json";

/**
 * Encodes a value the way `serde_qs` does: nested keys in brackets, arrays by
 * index, `null`/`undefined` omitted.
 */
export function toQueryString(value: Record<string, unknown>): string {
	const params = new URLSearchParams();
	const append = (key: string, item: unknown): void => {
		if (item === null || item === undefined) {
			return;
		}
		if (Array.isArray(item)) {
			item.forEach((entry, index) => append(`${key}[${index}]`, entry));
		} else if (typeof item === "object") {
			for (const [field, entry] of Object.entries(item as Record<string, unknown>)) {
				append(`${key}[${field}]`, entry);
			}
		} else {
			params.append(key, String(item));
		}
	};
	for (const [key, item] of Object.entries(value)) {
		append(key, item);
	}
	return params.toString();
}

/** The transport shared by every generated method. */
export class BaseClient {
	readonly serverUrl: string;
	readonly headers: Record<string, string>;
	readonly fetchImpl: typeof fetch;
	readonly liveOptions: LiveOptions;
	#live: LiveConnection | null = null;

	constructor(options: ClientOptions = {}) {
		this.serverUrl = (options.serverUrl ?? DEFAULT_SERVER_URL ?? "").replace(/\/+$/, "");
		this.headers = { ...(options.headers ?? {}) };
		this.fetchImpl = options.fetch ?? ((input, init) => globalThis.fetch(input, init));
		this.liveOptions = options.live ?? {};
	}

	/**
	 * The live connection: one WebSocket for every subscription, live mutation
	 * and channel, opened on first use. Read `live.status` or call
	 * `live.onStatus(...)` for a connection banner, and `live.close()` when done.
	 */
	get live(): LiveConnection {
		if (this.#live === null) {
			this.#live = new LiveConnection(liveUrl(this.serverUrl, LIVE_PATH), this.liveOptions);
		}
		return this.#live;
	}

	protected async call<T>(
		method: string,
		path: string,
		encoding: Encoding,
		input: Record<string, unknown>,
		idempotencyKey?: string,
	): Promise<T> {
		let url = `${this.serverUrl}${path}`;
		const headers: Record<string, string> = { Accept: "application/json", ...this.headers };
		if (idempotencyKey !== undefined) {
			headers["Idempotency-Key"] = idempotencyKey;
		}
		let body: string | undefined;
		if (encoding === "query") {
			const query = toQueryString(input);
			if (query !== "") {
				url += (url.includes("?") ? "&" : "?") + query;
			}
		} else if (encoding === "form") {
			headers["Content-Type"] = "application/x-www-form-urlencoded";
			body = toQueryString(input);
		} else {
			headers["Content-Type"] = "application/json";
			// Absent optional arguments are omitted, as `serde_qs` omits them:
			// the server fills `#[server(default)]` arguments in, and `Option`
			// arguments read a missing key as `None`.
			const present = Object.fromEntries(
				Object.entries(input).filter(([, item]) => item !== undefined && item !== null),
			);
			body = JSON.stringify(present);
		}
		let response: Response;
		try {
			response = await this.fetchImpl(url, { method, headers, body });
		} catch (cause) {
			throw new FnError("network", `could not reach ${url}: ${String(cause)}`, { cause });
		}
		const text = await response.text();
		if (response.status >= 400) {
			throw FnError.fromResponse(response.status, text);
		}
		if (text === "") {
			return null as T;
		}
		try {
			return JSON.parse(text) as T;
		} catch (cause) {
			throw new FnError("decode", `the response was not JSON: ${String(cause)}`, {
				status: response.status,
				raw: text,
				cause,
			});
		}
	}
}

/** The server origin baked in at generation time; `undefined` means the page's own origin. */
export const DEFAULT_SERVER_URL: string | undefined = "https://todos.example";

/** Where the server serves the live socket, relative to its origin. */
export const LIVE_PATH = "/live";

/** A typed client for the Todos RPC, version 1.2.3. */
export class Client extends BaseClient {

	/**
	 * Lists todos.
	 *
	 * Newest first.
	 *
	 * - `filter` — Which todos to list.
	 * - `limit` — How many to return.
	 */
	listTodos(input: {
		/** Which todos to list. */
		filter: TodoFilter;
		/** How many to return. */
		limit?: number | null
	}): Promise<Todo[]> {
		return this.call<Todo[]>("POST", "/api/list_todos", "form", input);
	}

	/**
	 * Creates a todo.
	 *
	 * - `title` — What needs doing.
	 */
	createTodo(input: {
		/** What needs doing. */
		title: string;
		tags?: string[]
	}): Promise<Todo> {
		return this.call<Todo>("POST", "/api/create_todo", "json", input);
	}

	/** Reads one todo. */
	getTodo(input: {
		id: number
	}): Promise<Todo | null> {
		return this.call<Todo | null>("GET", "/api/get_todo", "query", input);
	}

	/** @deprecated */
	counts(): Promise<Counts> {
		return this.call<Counts>("POST", "/api/counts", "form", {});
	}

	/**
	 * Finds todos whose title contains the text.
	 *
	 * - `text` — What to look for.
	 */
	readonly searchTodos = Object.assign(
		(input: {
			/** What to look for. */
			text: string
		}): Promise<Todo[]> =>
			this.call<Todo[]>("POST", "/api/search_todos", "json", input),
		{
			/**
			 * Watches the result: `onValue` gets the first value and each new one, until the
			 * returned function is called. A failure goes to `onError`, and the
			 * subscription recovers on the next change.
			 */
			subscribe: (
				input: {
					/** What to look for. */
					text: string
				},
				onValue: (value: Todo[], version: number) => void,
				onError?: (error: LiveError) => void,
			): Unsubscribe => this.live.subscribe<Todo[]>("search_todos", input, onValue, onError),
		},
	);

	/**
	 * Marks a todo done.
	 *
	 * - `id` — The todo.
	 */
	readonly completeTodo = Object.assign(
		(input: {
			/** The todo. */
			id: number
		}, options?: CallOptions): Promise<Todo> =>
			this.call<Todo>("POST", "/api/complete_todo", "json", input, options?.idempotencyKey),
		{
			/**
			 * Runs the mutation over the live socket. It resolves once this client's
			 * subscriptions show the write, and a call whose answer is lost is sent
			 * again after a reconnect with the same key, so it runs once.
			 */
			live: (input: {
				/** The todo. */
				id: number
			}, options?: CallOptions): Promise<Todo> =>
				this.live.mutate<Todo>("complete_todo", input, options?.idempotencyKey),
		},
	);

	readonly clearDone = Object.assign(
		(options?: CallOptions): Promise<null> =>
			this.call<null>("POST", "/api/clear_done", "json", {}, options?.idempotencyKey),
		{
			/**
			 * Runs the mutation over the live socket. It resolves once this client's
			 * subscriptions show the write, and a call whose answer is lost is sent
			 * again after a reconnect with the same key, so it runs once.
			 */
			live: (options?: CallOptions): Promise<null> =>
				this.live.mutate<null>("clear_done", {}, options?.idempotencyKey),
		},
	);

	/**
	 * Summarizes the open todos with an outside service.
	 *
	 * - `style` — How to write it.
	 */
	summarizeTodos(input: {
		/** How to write it. */
		style: string
	}): Promise<string> {
		return this.call<string>("POST", "/api/summarize_todos", "json", input);
	}

	/** Who is looking at a todo list, and what they're doing. */
	readonly todoRoom = {
		/**
		 * Joins the channel: signals and presence arrive through `options`, and the
		 * join is made again after a reconnect, until `leave()`.
		 */
		join: (
			args: TodoRoom,
			options?: JoinOptions<Event, Viewer>,
		): ChannelHandle<Event, Viewer> =>
			this.live.join<Event, Viewer>(
				"todo_room",
				channelKey(["list", "filter"], args as unknown as Record<string, unknown>),
				args,
				options,
			),
	};
}

/** A client with the default options; construct `new Client(...)` for anything else. */
export const client = new Client();

