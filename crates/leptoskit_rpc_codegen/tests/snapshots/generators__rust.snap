// Generated by `leptoskit rpc generate` from Todos 1.2.3. Do not edit; regenerate instead.
//! The transport: one method per published function.

use crate::models::*;
use serde::Serialize;
use serde::de::DeserializeOwned;

/// The server origin baked in at generation time.
pub const DEFAULT_SERVER_URL: &str = "https://todos.example";

#[derive(Serialize)]
struct ListTodosInput {
	/// Which todos to list.
	filter: TodoFilter,
	/// How many to return.
	#[serde(default, skip_serializing_if = "Option::is_none")]
	limit: Option<u32>,
}

#[derive(Serialize)]
struct CreateTodoInput {
	/// What needs doing.
	title: String,
	#[serde(default, skip_serializing_if = "Option::is_none")]
	tags: Option<Vec<String>>,
}

#[derive(Serialize)]
struct GetTodoInput {
	id: u64,
}

/// How a failed call is classified, mirroring `leptoskit_rpc::FnError`.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum FnErrorKind {
	/// The request never arrived or was dropped.
	Network,
	/// The server rejected the arguments.
	Invalid,
	/// The function failed while running.
	Server,
	/// A response that wouldn't parse.
	Decode,
	/// Everything else.
	Other,
}

impl FnErrorKind {
	/// Whether retrying could plausibly succeed: only when no answer arrived.
	/// Server errors are final, because the server reports a refusal such as
	/// "not found" the same way as an outage.
	pub fn retryable(self) -> bool {
		matches!(self, Self::Network)
	}
}

/// A failed call.
#[derive(Debug, thiserror::Error)]
pub enum Error {
	/// The RPC answered with an error.
	#[error("{kind:?} error: {message}")]
	Fn {
		/// The classification.
		kind: FnErrorKind,
		/// The human-readable message.
		message: String,
	},
	/// The transport failed before or after the call.
	#[error("transport error: {0}")]
	Transport(#[source] reqwest::Error),
	/// The response was not the JSON the schema promised.
	#[error("decode error: {0}")]
	Decode(#[source] serde_json::Error),
}

/// How a request body is encoded.
#[derive(Clone, Copy)]
enum Encoding {
	Query,
	Form,
	Json,
}

/// A typed client for the RPC.
#[derive(Debug, Clone)]
pub struct Client {
	server_url: String,
	http: reqwest::Client,
	headers: reqwest::header::HeaderMap,
}

impl Default for Client {
	fn default() -> Self {
		Self::new()
	}
}

impl Client {
	/// A client for [`DEFAULT_SERVER_URL`].
	pub fn new() -> Self {
		Self {
			server_url: DEFAULT_SERVER_URL.trim_end_matches('/').to_owned(),
			http: reqwest::Client::new(),
			headers: reqwest::header::HeaderMap::new(),
		}
	}

	/// A client for `server_url`, an origin such as `https://api.example.com`.
	pub fn with_server_url(server_url: impl Into<String>) -> Self {
		Self {
			server_url: server_url.into().trim_end_matches('/').to_owned(),
			..Self::new()
		}
	}

	/// Sets a header sent with every request, such as `Authorization`.
	pub fn with_header(
		mut self,
		name: reqwest::header::HeaderName,
		value: reqwest::header::HeaderValue,
	) -> Self {
		self.headers.insert(name, value);
		self
	}

	/// The origin this client sends requests to.
	pub fn server_url(&self) -> &str {
		&self.server_url
	}

	async fn exchange(
		&self,
		method: &str,
		path: &str,
		encoding: Encoding,
		payload: &impl Serialize,
	) -> Result<reqwest::Response, Error> {
		let mut url = format!("{}{}", self.server_url, path);
		let request = match encoding {
			Encoding::Query => {
				let query = serde_qs::to_string(payload)
					.map_err(|error| Error::Fn { kind: FnErrorKind::Invalid, message: error.to_string() })?;
				if !query.is_empty() {
					url.push(if url.contains('?') { '&' } else { '?' });
					url.push_str(&query);
				}
				self.http.request(reqwest::Method::from_bytes(method.as_bytes()).expect("a known method"), &url)
			}
			Encoding::Form => {
				let body = serde_qs::to_string(payload)
					.map_err(|error| Error::Fn { kind: FnErrorKind::Invalid, message: error.to_string() })?;
				self.http
					.request(reqwest::Method::from_bytes(method.as_bytes()).expect("a known method"), &url)
					.header(reqwest::header::CONTENT_TYPE, "application/x-www-form-urlencoded")
					.body(body)
			}
			Encoding::Json => {
				// Absent optional arguments are omitted, as `serde_qs` omits
				// them: the server fills defaulted arguments in, and `Option`
				// arguments read a missing key as `None`.
				let encoded = serde_json::to_value(payload)
					.map_err(|error| Error::Fn { kind: FnErrorKind::Invalid, message: error.to_string() })?;
				let present = match encoded {
					serde_json::Value::Object(fields) => serde_json::Value::Object(
						fields
							.into_iter()
							.filter(|(_, item)| !item.is_null())
							.collect(),
					),
					other => other,
				};
				self.http
					.request(reqwest::Method::from_bytes(method.as_bytes()).expect("a known method"), &url)
					.header(reqwest::header::CONTENT_TYPE, "application/json")
					.body(present.to_string())
			}
		};
		self.finish(request).await
	}

	async fn finish(
		&self,
		mut request: reqwest::RequestBuilder,
	) -> Result<reqwest::Response, Error> {
		request = request
			.headers(self.headers.clone())
			.header(reqwest::header::ACCEPT, "application/json");
		let response = request.send().await.map_err(Error::Transport)?;
		let status = response.status();
		if status.is_client_error() || status.is_server_error() {
			let body = response.text().await.map_err(Error::Transport)?;
			return Err(classify(status.as_u16(), &body));
		}
		Ok(response)
	}

	async fn call<T: DeserializeOwned>(
		&self,
		method: &str,
		path: &str,
		encoding: Encoding,
		payload: &impl Serialize,
	) -> Result<T, Error> {
		let response = self.exchange(method, path, encoding, payload).await?;
		let text = response.text().await.map_err(Error::Transport)?;
		serde_json::from_str(&text).map_err(Error::Decode)
	}

	async fn call_void(
		&self,
		method: &str,
		path: &str,
		encoding: Encoding,
		payload: &impl Serialize,
	) -> Result<(), Error> {
		self.exchange(method, path, encoding, payload).await?;
		Ok(())
	}
}

/// Parses the server's `Kind|message` error text.
fn classify(_status: u16, body: &str) -> Error {
	let (kind, message) = match body.split_once('|') {
		Some(("Request", message)) => (FnErrorKind::Network, message.to_owned()),
		Some(("Args" | "MissingArg", message)) => (FnErrorKind::Invalid, message.to_owned()),
		Some(("ServerError" | "MiddlewareError" | "WrappedServerFn", message)) => {
			(FnErrorKind::Server, message.to_owned())
		}
		Some(("Deserialization" | "Serialization", message)) => {
			(FnErrorKind::Decode, message.to_owned())
		}
		_ => (FnErrorKind::Other, body.to_owned()),
	};
	Error::Fn { kind, message }
}

impl Client {
	/// Lists todos.
	/// 
	/// Newest first.
	///
	/// # Arguments
	///
	/// * `filter` — Which todos to list.
	/// * `limit` — How many to return.
	pub async fn list_todos(&self, filter: TodoFilter, limit: Option<u32>) -> Result<Vec<Todo>, Error> {
		self.call("POST", "/api/list_todos", Encoding::Form, &ListTodosInput { filter, limit }).await
	}

	/// Creates a todo.
	///
	/// # Arguments
	///
	/// * `title` — What needs doing.
	pub async fn create_todo(&self, title: String, tags: Option<Vec<String>>) -> Result<Todo, Error> {
		self.call("POST", "/api/create_todo", Encoding::Json, &CreateTodoInput { title, tags }).await
	}

	/// Reads one todo.
	pub async fn get_todo(&self, id: u64) -> Result<Option<Todo>, Error> {
		self.call("GET", "/api/get_todo", Encoding::Query, &GetTodoInput { id }).await
	}

	#[deprecated]
	pub async fn counts(&self) -> Result<Counts, Error> {
		self.call("POST", "/api/counts", Encoding::Form, &serde_json::json!({})).await
	}

}

