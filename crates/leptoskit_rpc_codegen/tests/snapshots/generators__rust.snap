// Generated by `leptoskit rpc generate` from Todos 1.2.3. Do not edit; regenerate instead.
//! Types for the Todos 1.2.3 RPC.

#![allow(clippy::all)]

/// One todo item.
#[derive(Debug, Clone, PartialEq, serde::Serialize, serde::Deserialize)]
pub struct Todo {
	/// Whether it is done.
	pub done: bool,
	pub id: u64,
	/// Free-form labels.
	#[serde(default, skip_serializing_if = "Option::is_none")]
	pub tags: Option<Vec<String>>,
	pub title: String,
}

/// Which todos to list.
#[derive(Debug, Clone, Copy, PartialEq, Eq, serde::Serialize, serde::Deserialize)]
pub enum TodoFilter {
	#[serde(rename = "all")]
	All,
	#[serde(rename = "done")]
	Done,
	#[serde(rename = "pending")]
	Pending,
}

pub type Counts = std::collections::HashMap<String, i64>;


