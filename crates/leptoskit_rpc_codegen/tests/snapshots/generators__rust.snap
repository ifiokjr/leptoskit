# Generated by `leptoskit rpc generate` from Todos 1.2.3. Do not edit; regenerate instead.
# The client is its own workspace so it builds from any directory. To share the
# app's target directory and lockfile instead, delete this table and add the
# crate to the app workspace's `members`.
[workspace]

[package]
name = "todos-client"
version = "1.2.3"
edition = "2021"
publish = false
description = "A typed client for the Todos RPC."

[dependencies]
reqwest = { version = "0.12", default-features = false, features = ["json", "rustls-tls"] }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
serde_qs = "0.15"
thiserror = "2"

