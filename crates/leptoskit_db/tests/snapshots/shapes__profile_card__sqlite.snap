SELECT "lk_shape_0"."handle", "lk_shape_0"."name", (SELECT count(*) FROM "posts" AS "lk_shape_1" WHERE "lk_shape_1"."author_id" = "lk_shape_0"."id" AND (("published" = ?1 OR "author_id" = ?2)) AND "deleted_at" IS NULL), (SELECT count(*) FROM "posts" AS "lk_shape_1" WHERE "lk_shape_1"."author_id" = "lk_shape_0"."id" AND ("published" = ?3) AND (("published" = ?4 OR "author_id" = ?5)) AND "deleted_at" IS NULL), (SELECT json_group_array(json("lk_value") ORDER BY "lk_rank") FROM (SELECT json_array(CASE WHEN "lk_shape_1"."id" IS NULL THEN NULL ELSE lower(hex("lk_shape_1"."id")) END, "lk_shape_1"."title", json((SELECT json_group_array(json("lk_value") ORDER BY "lk_rank") FROM (SELECT json_array("lk_shape_2"."name") AS "lk_value", row_number() OVER (ORDER BY "name" ASC, "id" ASC) AS "lk_rank" FROM "tags" AS "lk_shape_2" WHERE "lk_shape_2"."id" IN (SELECT "lk_link_3"."tag_id" FROM "post_tags" AS "lk_link_3" WHERE "lk_link_3"."post_id" = "lk_shape_1"."id" AND (("private" = ?6 OR (SELECT count(*) FROM "posts" AS "lk_count_4" WHERE (("id" = "lk_link_3"."post_id" AND "author_id" = ?7)) AND (("published" = ?8 OR "author_id" = ?9))) > ?10))) ORDER BY "name" ASC, "id" ASC) AS "lk_rows_3")), (SELECT count(*) FROM "comments" AS "lk_shape_2" WHERE "lk_shape_2"."post_id" = "lk_shape_1"."id")) AS "lk_value", row_number() OVER (ORDER BY "rank" DESC, "id" ASC) AS "lk_rank" FROM "posts" AS "lk_shape_1" WHERE "lk_shape_1"."author_id" = "lk_shape_0"."id" AND (("published" = ?11 OR "author_id" = ?12)) AND "deleted_at" IS NULL ORDER BY "rank" DESC, "id" ASC LIMIT 2) AS "lk_rows_2"), (SELECT json_array(CASE WHEN "lk_shape_1"."id" IS NULL THEN NULL ELSE lower(hex("lk_shape_1"."id")) END, "lk_shape_1"."title", json((SELECT json_group_array(json("lk_value") ORDER BY "lk_rank") FROM (SELECT json_array("lk_shape_2"."name") AS "lk_value", row_number() OVER (ORDER BY "name" ASC, "id" ASC) AS "lk_rank" FROM "tags" AS "lk_shape_2" WHERE "lk_shape_2"."id" IN (SELECT "lk_link_3"."tag_id" FROM "post_tags" AS "lk_link_3" WHERE "lk_link_3"."post_id" = "lk_shape_1"."id" AND (("private" = ?13 OR (SELECT count(*) FROM "posts" AS "lk_count_4" WHERE (("id" = "lk_link_3"."post_id" AND "author_id" = ?14)) AND (("published" = ?15 OR "author_id" = ?16))) > ?17))) ORDER BY "name" ASC, "id" ASC) AS "lk_rows_3")), (SELECT count(*) FROM "comments" AS "lk_shape_2" WHERE "lk_shape_2"."post_id" = "lk_shape_1"."id")) FROM "posts" AS "lk_shape_1" WHERE "lk_shape_1"."author_id" = "lk_shape_0"."id" AND (instr("title", ?18) > 0) AND (("published" = ?19 OR "author_id" = ?20)) AND "deleted_at" IS NULL ORDER BY "rank" ASC, "id" ASC LIMIT 1) FROM "authors" AS "lk_shape_0" WHERE ("handle" = ?21) AND "deleted_at" IS NULL ORDER BY "handle" ASC LIMIT 5
