ALTER TABLE "budgets" ADD CONSTRAINT "budgets_owner_id_fkey" FOREIGN KEY ("owner_id") REFERENCES "actors" ("id") ON DELETE RESTRICT;

ALTER TABLE "budgets" ADD CONSTRAINT "budgets_reviewer_id_fkey" FOREIGN KEY ("reviewer_id") REFERENCES "actors" ("id") ON DELETE SET NULL;

ALTER TABLE "people" ADD CONSTRAINT "people_id_fkey" FOREIGN KEY ("id") REFERENCES "actors" ("id") ON DELETE CASCADE;

ALTER TABLE "teams" ADD CONSTRAINT "teams_id_fkey" FOREIGN KEY ("id") REFERENCES "actors" ("id") ON DELETE CASCADE;

CREATE TRIGGER "live_capture" AFTER INSERT OR UPDATE OR DELETE ON "actors" FOR EACH ROW EXECUTE FUNCTION "live"."capture"('actors', 'id', 'id', 'kind');

CREATE CONSTRAINT TRIGGER "seal" AFTER INSERT ON "live"."pending" DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION "live"."seal"();
