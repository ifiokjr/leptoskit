---
source: crates/leptoskit_db/tests/row_security.rs
expression: "rendered.join(\"\\n\")"
---
_leptoskit_audit SELECT
  using: NULLIF(current_setting('leptoskit.audit_reader', true), '')::boolean
  check: -
_leptoskit_audit INSERT
  using: -
  check: 1 = 1
_leptoskit_audit UPDATE
  using: 1 = 0
  check: 1 = 0
_leptoskit_audit DELETE
  using: 1 = 0
  check: -
notes SELECT
  using: ("writer_id" = ANY(NULLIF(current_setting('leptoskit.desk', true), '')::uuid[]) OR (NOT ("writer_id" = ANY(NULLIF(current_setting('leptoskit.desk', true), '')::uuid[])) AND "open" = TRUE))
  check: -
notes INSERT
  using: -
  check: 1 = 0
notes UPDATE
  using: 1 = 0
  check: 1 = 0
notes DELETE
  using: 1 = 0
  check: -
posts SELECT
  using: (("published" = TRUE OR "writer_id" = NULLIF(current_setting('leptoskit.viewer', true), '')::uuid) OR (SELECT count(*) FROM "shares" AS "lk_count_1" WHERE (("post_id" = "posts"."id" AND "writer_id" = NULLIF(current_setting('leptoskit.viewer', true), '')::uuid)) AND ("writer_id" = NULLIF(current_setting('leptoskit.viewer', true), '')::uuid)) > 0)
  check: -
posts INSERT
  using: -
  check: "writer_id" = NULLIF(current_setting('leptoskit.viewer', true), '')::uuid
posts UPDATE
  using: (("writer_id" = NULLIF(current_setting('leptoskit.viewer', true), '')::uuid AND NOT ("locked" = TRUE)) OR "writer_id" = NULLIF(current_setting('leptoskit.viewer', true), '')::uuid)
  check: (("writer_id" = NULLIF(current_setting('leptoskit.viewer', true), '')::uuid AND NOT ("locked" = TRUE)) OR ("writer_id" = NULLIF(current_setting('leptoskit.viewer', true), '')::uuid AND "deleted_at" IS NOT NULL))
posts DELETE
  using: "writer_id" = NULLIF(current_setting('leptoskit.viewer', true), '')::uuid
  check: -
shares SELECT
  using: "writer_id" = NULLIF(current_setting('leptoskit.viewer', true), '')::uuid
  check: -
shares INSERT
  using: -
  check: 1 = 1
shares UPDATE
  using: 1 = 0
  check: 1 = 0
shares DELETE
  using: 1 = 1
  check: -
writers SELECT
  using: 1 = 1
  check: -
writers INSERT
  using: -
  check: "id" = NULLIF(current_setting('leptoskit.viewer', true), '')::uuid
writers UPDATE
  using: "id" = NULLIF(current_setting('leptoskit.viewer', true), '')::uuid
  check: "id" = NULLIF(current_setting('leptoskit.viewer', true), '')::uuid
writers DELETE
