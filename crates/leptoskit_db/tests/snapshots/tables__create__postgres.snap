CREATE TABLE "posts" (
	"id" uuid NOT NULL,
	"author_id" uuid NOT NULL,
	"editor_id" uuid,
	"title" text NOT NULL,
	"status" text NOT NULL DEFAULT 'draft',
	"published_at" timestamptz,
	CONSTRAINT "posts_pkey" PRIMARY KEY ("id"),
	CONSTRAINT "posts_title_length" CHECK (char_length("title") >= 1 AND char_length("title") <= 200),
	CONSTRAINT "posts_status_values" CHECK ("status" IN ('draft', 'published'))
);

CREATE INDEX "posts_author_id_published_at_idx" ON "posts" ("author_id", "published_at");

COMMENT ON TABLE "posts" IS 'Something a user wrote.';

CREATE TABLE "users" (
	"id" uuid NOT NULL,
	"handle" text NOT NULL,
	"email" text NOT NULL,
	"password_hash" text NOT NULL,
	"role" text NOT NULL,
	"karma" integer NOT NULL DEFAULT 0,
	"settings" jsonb NOT NULL,
	"created_at" timestamptz NOT NULL,
	"updated_at" timestamptz NOT NULL,
	"deleted_at" timestamptz,
	CONSTRAINT "users_pkey" PRIMARY KEY ("id"),
	CONSTRAINT "users_handle_length" CHECK (char_length("handle") >= 3 AND char_length("handle") <= 32),
	CONSTRAINT "users_handle_pattern" CHECK ("handle" ~ '^[a-z0-9_]+$'),
	CONSTRAINT "users_role_values" CHECK ("role" IN ('member', 'mod', 'super_admin')),
	CONSTRAINT "users_karma_range" CHECK ("karma" >= 0 AND "karma" <= 100)
);

CREATE UNIQUE INDEX "users_handle_key" ON "users" ("handle") WHERE "deleted_at" IS NULL;

COMMENT ON TABLE "users" IS 'Someone with an account.';

COMMENT ON COLUMN "users"."handle" IS 'Shown on profiles.';

CREATE TABLE "content"."post_tags" (
	"post_id" uuid NOT NULL,
	"tag" text NOT NULL,
	"position" smallint NOT NULL,
	CONSTRAINT "content_post_tags_pkey" PRIMARY KEY ("post_id", "tag"),
	CONSTRAINT "content_post_tags_position_check" CHECK (position >= 0)
