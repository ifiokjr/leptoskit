-- @generated by leptoskit db. Edits are allowed: the migration is applied as written, and schema.json beside it records the schema it produces.
-- dialect: sqlite
--
-- `users.handle` isn't checked by SQLite, which has no built-in regular expressions; the app validates it

CREATE TABLE "accounts" (
	"id" BLOB NOT NULL CHECK (length("id") = 16),
	"nickname" TEXT,
	"small" INTEGER NOT NULL CHECK ("small" BETWEEN -32768 AND 32767),
	"medium" INTEGER NOT NULL CHECK ("medium" BETWEEN -2147483648 AND 2147483647),
	"large" INTEGER NOT NULL,
	"huge" INTEGER NOT NULL,
	"ratio" REAL NOT NULL,
	"avatar" BLOB NOT NULL,
	"born_on" TEXT NOT NULL,
	"external" BLOB NOT NULL CHECK (length("external") = 16),
	"flags" TEXT NOT NULL CHECK (json_valid("flags")),
	"raw" TEXT CHECK (json_valid("raw")),
	CONSTRAINT "accounts_pkey" PRIMARY KEY ("id")
) STRICT;

CREATE TABLE "posts" (
	"id" BLOB NOT NULL CHECK (length("id") = 16),
	"author_id" BLOB NOT NULL CHECK (length("author_id") = 16),
	"editor_id" BLOB CHECK (length("editor_id") = 16),
	"title" TEXT NOT NULL,
	"status" TEXT NOT NULL DEFAULT 'draft',
	"published_at" TEXT,
	CONSTRAINT "posts_pkey" PRIMARY KEY ("id"),
	CONSTRAINT "posts_author_id_fkey" FOREIGN KEY ("author_id") REFERENCES "users" ("id") ON DELETE CASCADE,
	CONSTRAINT "posts_editor_id_fkey" FOREIGN KEY ("editor_id") REFERENCES "users" ("id") ON DELETE SET NULL,
	CONSTRAINT "posts_title_length" CHECK (length("title") >= 1 AND length("title") <= 200),
	CONSTRAINT "posts_status_values" CHECK ("status" IN ('draft', 'published'))
) STRICT;

CREATE INDEX "posts_author_id_published_at_idx" ON "posts" ("author_id", "published_at");

CREATE TABLE "users" (
	"id" BLOB NOT NULL CHECK (length("id") = 16),
	"handle" TEXT NOT NULL,
	"email" TEXT NOT NULL,
	"password_hash" TEXT NOT NULL,
	"role" TEXT NOT NULL,
	"karma" INTEGER NOT NULL DEFAULT 0 CHECK ("karma" BETWEEN -2147483648 AND 2147483647),
	"settings" TEXT NOT NULL CHECK (json_valid("settings")),
	"created_at" TEXT NOT NULL,
	"updated_at" TEXT NOT NULL,
	"deleted_at" TEXT,
	CONSTRAINT "users_pkey" PRIMARY KEY ("id"),
	CONSTRAINT "users_handle_length" CHECK (length("handle") >= 3 AND length("handle") <= 32),
	CONSTRAINT "users_role_values" CHECK ("role" IN ('member', 'mod', 'super_admin')),
	CONSTRAINT "users_karma_range" CHECK ("karma" >= 0 AND "karma" <= 100)
) STRICT;

CREATE UNIQUE INDEX "users_handle_key" ON "users" ("handle") WHERE "deleted_at" IS NULL;

CREATE TABLE "content_post_tags" (
	"post_id" BLOB NOT NULL CHECK (length("post_id") = 16),
	"tag" TEXT NOT NULL,
	"position" INTEGER NOT NULL CHECK ("position" BETWEEN -32768 AND 32767),
	CONSTRAINT "content_post_tags_pkey" PRIMARY KEY ("post_id", "tag"),
	CONSTRAINT "content_post_tags_post_id_fkey" FOREIGN KEY ("post_id") REFERENCES "posts" ("id") ON DELETE RESTRICT,
	CONSTRAINT "content_post_tags_position_check" CHECK (position >= 0)
) STRICT;

CREATE UNIQUE INDEX "content_post_tags_post_id_position_key" ON "content_post_tags" ("post_id", "position");
