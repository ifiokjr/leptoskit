-- @generated by leptoskit db. Edits are allowed: the migration is applied as written, and schema.json beside it records the schema it produces.
-- dialect: sqlite

CREATE TABLE "_leptoskit_audit" (
	"id" BLOB NOT NULL CHECK (length("id") = 16),
	"at" TEXT NOT NULL,
	"table_name" TEXT NOT NULL,
	"row_key" TEXT NOT NULL,
	"op" TEXT NOT NULL,
	"actor" BLOB CHECK (length("actor") = 16),
	"reason" TEXT,
	"before" TEXT CHECK (json_valid("before")),
	"after" TEXT CHECK (json_valid("after")),
	CONSTRAINT "_leptoskit_audit_pkey" PRIMARY KEY ("id"),
	CONSTRAINT "_leptoskit_audit_op_values" CHECK ("op" IN ('insert', 'update', 'delete'))
) STRICT;

CREATE INDEX "_leptoskit_audit_table_name_row_key_idx" ON "_leptoskit_audit" ("table_name", "row_key");

CREATE INDEX "_leptoskit_audit_at_idx" ON "_leptoskit_audit" ("at");

CREATE TABLE "actors" (
	"id" BLOB NOT NULL CHECK (length("id") = 16),
	"kind" TEXT NOT NULL,
	CONSTRAINT "actors_pkey" PRIMARY KEY ("id"),
	CONSTRAINT "actors_kind_values" CHECK ("kind" IN ('person', 'team', 'robot'))
) STRICT;

CREATE TABLE "bots" (
	"id" BLOB NOT NULL CHECK (length("id") = 16),
	"model" TEXT NOT NULL,
	CONSTRAINT "bots_pkey" PRIMARY KEY ("id"),
	CONSTRAINT "bots_id_fkey" FOREIGN KEY ("id") REFERENCES "actors" ("id") ON DELETE CASCADE
) STRICT;

CREATE TABLE "budgets" (
	"id" BLOB NOT NULL CHECK (length("id") = 16),
	"owner_id" BLOB NOT NULL CHECK (length("owner_id") = 16),
	"reviewer_id" BLOB CHECK (length("reviewer_id") = 16),
	"name" TEXT NOT NULL,
	"deleted_at" TEXT,
	CONSTRAINT "budgets_pkey" PRIMARY KEY ("id"),
	CONSTRAINT "budgets_owner_id_fkey" FOREIGN KEY ("owner_id") REFERENCES "actors" ("id") ON DELETE RESTRICT,
	CONSTRAINT "budgets_reviewer_id_fkey" FOREIGN KEY ("reviewer_id") REFERENCES "actors" ("id") ON DELETE SET NULL
) STRICT;

CREATE TABLE "people" (
	"id" BLOB NOT NULL CHECK (length("id") = 16),
	"name" TEXT NOT NULL,
	"listed" INTEGER NOT NULL CHECK ("listed" IN (0, 1)),
	"deleted_at" TEXT,
	CONSTRAINT "people_pkey" PRIMARY KEY ("id"),
	CONSTRAINT "people_id_fkey" FOREIGN KEY ("id") REFERENCES "actors" ("id") ON DELETE CASCADE
) STRICT;

CREATE TABLE "teams" (
	"id" BLOB NOT NULL CHECK (length("id") = 16),
	"title" TEXT NOT NULL,
	"size" INTEGER NOT NULL CHECK ("size" BETWEEN -2147483648 AND 2147483647),
	CONSTRAINT "teams_pkey" PRIMARY KEY ("id"),
	CONSTRAINT "teams_id_fkey" FOREIGN KEY ("id") REFERENCES "actors" ("id") ON DELETE CASCADE
) STRICT;

CREATE TABLE "live_changes" (
	"seq" INTEGER NOT NULL,
	"txid" INTEGER,
	"version" INTEGER,
	"table_name" TEXT NOT NULL,
	"op" TEXT NOT NULL,
	"key" TEXT NOT NULL CHECK (json_valid("key")),
	"old" TEXT CHECK (json_valid("old")),
	"new" TEXT CHECK (json_valid("new")),
	"changed" TEXT NOT NULL CHECK (json_valid("changed")),
	CONSTRAINT "live_changes_pkey" PRIMARY KEY ("seq"),
	CONSTRAINT "live_changes_op_values" CHECK ("op" IN ('I', 'U', 'D'))
) STRICT;

CREATE INDEX "live_changes_txid_idx" ON "live_changes" ("txid");

CREATE INDEX "live_changes_version_idx" ON "live_changes" ("version");

CREATE TABLE "live_commits" (
	"version" INTEGER NOT NULL,
	"txid" INTEGER,
	"committed_at" TEXT NOT NULL,
	"actor" BLOB CHECK (length("actor") = 16),
	"origin" TEXT NOT NULL,
	CONSTRAINT "live_commits_pkey" PRIMARY KEY ("version")
) STRICT;

CREATE UNIQUE INDEX "live_commits_txid_key" ON "live_commits" ("txid");

CREATE TRIGGER "live_actors_delete" AFTER DELETE ON "actors" FOR EACH ROW BEGIN
	INSERT INTO "live_changes" ("seq", "txid", "version", "table_name", "op", "key", "old", "new", "changed") VALUES ((SELECT coalesce(max("seq"), 0) + 1 FROM "live_changes"), NULL, NULL, 'actors', 'D', json_array(CASE WHEN OLD."id" IS NULL THEN NULL ELSE lower(hex(OLD."id")) END), json_object('id', CASE WHEN OLD."id" IS NULL THEN NULL ELSE lower(hex(OLD."id")) END, 'kind', OLD."kind"), NULL, '[]');
END;

CREATE TRIGGER "live_actors_insert" AFTER INSERT ON "actors" FOR EACH ROW BEGIN
	INSERT INTO "live_changes" ("seq", "txid", "version", "table_name", "op", "key", "old", "new", "changed") VALUES ((SELECT coalesce(max("seq"), 0) + 1 FROM "live_changes"), NULL, NULL, 'actors', 'I', json_array(CASE WHEN NEW."id" IS NULL THEN NULL ELSE lower(hex(NEW."id")) END), NULL, json_object('id', CASE WHEN NEW."id" IS NULL THEN NULL ELSE lower(hex(NEW."id")) END, 'kind', NEW."kind"), '[]');
END;

CREATE TRIGGER "live_actors_update" AFTER UPDATE ON "actors" FOR EACH ROW BEGIN
	INSERT INTO "live_changes" ("seq", "txid", "version", "table_name", "op", "key", "old", "new", "changed") VALUES ((SELECT coalesce(max("seq"), 0) + 1 FROM "live_changes"), NULL, NULL, 'actors', 'U', json_array(CASE WHEN NEW."id" IS NULL THEN NULL ELSE lower(hex(NEW."id")) END), json_object('id', CASE WHEN OLD."id" IS NULL THEN NULL ELSE lower(hex(OLD."id")) END, 'kind', OLD."kind"), json_object('id', CASE WHEN NEW."id" IS NULL THEN NULL ELSE lower(hex(NEW."id")) END, 'kind', NEW."kind"), (SELECT json_group_array("value") FROM json_each(json_array(CASE WHEN OLD."id" IS NOT NEW."id" THEN 'id' END, CASE WHEN OLD."kind" IS NOT NEW."kind" THEN 'kind' END)) WHERE "type" <> 'null'));
END;
