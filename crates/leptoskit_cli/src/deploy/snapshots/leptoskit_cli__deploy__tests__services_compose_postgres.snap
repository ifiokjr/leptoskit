next:
  1. Choose each service's token, a long random secret the app and the service share, and keep it the same across deploys: LEPTOSKIT_SERVICE_ANALYTICS_TOKEN, LEPTOSKIT_SERVICE_BILLING_TOKEN, LEPTOSKIT_SERVICE_CARDS_TOKEN, each from `openssl rand -hex 32`.
  2. Choose the database password: `export POSTGRES_PASSWORD="$(openssl rand -hex 24)"`, or put it in .env.
  3. Choose each service's database password: LEPTOSKIT_SERVICE_ANALYTICS_DATABASE_PASSWORD. Postgres creates their roles and databases on its first start; on a volume that already exists, run the db-services script from compose.yaml with `docker compose exec db sh`.
  4. Set LEPTOSKIT_PUBLIC_ORIGIN to the address people use, such as https://app.example.com; it defaults to http://localhost:3000.
  5. Start it: `docker compose up --build`

===== Dockerfile =====
# syntax=docker/dockerfile:1
#
# The container for notes, written by `leptoskit generate deploy`. It's yours
# to edit: running the generator again keeps your changes unless you pass
# --force. Build it from the project root:
#
#   docker build -t notes .
#
# The first stage runs `leptoskit build --release`, as you would on your
# machine. The second runs the server as an unprivileged user that writes
# nothing to the image's filesystem, so it works with a read-only root
# filesystem.

# The Rust release that builds the app. `1` is the latest stable; pin one,
# such as 1.96, to build the same way every time.
ARG RUST_VERSION=1
# The leptoskit CLI that builds the app. Keep it in step with the `leptoskit`
# version in Cargo.toml.
ARG LEPTOSKIT_VERSION=[version]
# binaryen's wasm-opt shrinks the release client.
ARG BINARYEN_VERSION=132

FROM rust:${RUST_VERSION}-bookworm AS build
ARG LEPTOSKIT_VERSION
ARG BINARYEN_VERSION
RUN curl --fail --silent --show-error --location \
      "https://github.com/WebAssembly/binaryen/releases/download/version_${BINARYEN_VERSION}/binaryen-version_${BINARYEN_VERSION}-$(uname -m)-linux.tar.gz" \
    | tar -xz -C /opt \
 && ln -s "/opt/binaryen-version_${BINARYEN_VERSION}/bin/wasm-opt" /usr/local/bin/wasm-opt
RUN cargo install leptoskit_cli --version "${LEPTOSKIT_VERSION}" --locked
WORKDIR /src
RUN rustup target add wasm32-unknown-unknown
COPY . .
# The cache mounts keep downloaded crates and compiled dependencies between
# builds. The server is copied out, since the target directory is a cache.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/target \
    --mount=type=cache,target=/src/.leptoskit \
    leptoskit build --release --platform web \
 && cp target/release/notes /usr/local/bin/notes \
 && install -D target/release/analytics_service /usr/local/lib/leptoskit/services/analytics \
 && install -D target/release/cards /usr/local/lib/leptoskit/services/cards

FROM debian:bookworm-slim
# curl answers the health check, and `app` is the unprivileged user the
# server runs as.
RUN apt-get update \
 && apt-get install --yes --no-install-recommends curl \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --user-group --uid 10001 --no-create-home app \
 && mkdir -p /volumes/exports \
 && chown app:app /volumes/exports
WORKDIR /app
COPY --from=build /usr/local/bin/notes /app/server
COPY --from=build /src/dist /app/dist
# The services: each runs this image with its own command, such as
# /app/services/<name>.
COPY --from=build /usr/local/lib/leptoskit/services /app/services
# What `leptoskit serve` sets from leptoskit.toml, for a container: listen on
# every interface, and serve the site from /app/dist.
ENV LEPTOS_ENV=PROD \
    LEPTOS_OUTPUT_NAME=notes_app \
    LEPTOS_SITE_ROOT=/app/dist \
    LEPTOS_SITE_PKG_DIR=pkg \
    LEPTOS_SITE_ADDR=0.0.0.0:3000
# These secrets come from the environment when the container starts, never
# from this file:
#   DATABASE_URL
#   LEPTOSKIT_SERVICE_ANALYTICS_TOKEN
#   LEPTOSKIT_SERVICE_BILLING_TOKEN
#   LEPTOSKIT_SERVICE_CARDS_TOKEN
USER app
EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=3s --start-period=30s --retries=3 \
  CMD port="${LEPTOSKIT_SERVICE_ADDR##*:}"; curl --fail --silent --output /dev/null "http://127.0.0.1:${port:-3000}/healthz"
CMD ["/app/server"]

===== .dockerignore =====
# Written by `leptoskit generate deploy`. Keeps the build context small, and
# local builds, databases, and secrets out of the image.
.git
**/target
/dist
/.leptoskit
/infra
/.kamal
/android/.gradle
/android/**/build
*.sqlite3*
*.dump
.env
.env.*

===== compose.yaml =====
# notes with Docker Compose, written by `leptoskit generate deploy`. It's
# yours to edit: running the generator again keeps your changes unless you
# pass --force.
#
#   docker compose up --build
#
# Its services run the same image with their own command. The inline
# `configs` below need Docker Compose 2.23.1 or newer.
#
# It reads these secrets from the environment, or from an `.env` file
# beside this one, which .dockerignore keeps out of the image. They never go
# in this file.
#
#   POSTGRES_PASSWORD
#   ANALYTICS_GEOIP_KEY
#   LEPTOSKIT_SERVICE_ANALYTICS_DATABASE_PASSWORD
#   LEPTOSKIT_SERVICE_ANALYTICS_TOKEN
#   LEPTOSKIT_SERVICE_BILLING_TOKEN
#   LEPTOSKIT_SERVICE_CARDS_TOKEN

name: notes

services:
  app:
    build: .
    image: notes
    # The edge below is the way in: it sends the services' public paths to
    # them, and everything else here.
    environment:
      DATABASE_URL: postgres://notes:${POSTGRES_PASSWORD}@db:5432/notes?sslmode=disable
      LEPTOSKIT_SERVICE_ANALYTICS_TOKEN: ${LEPTOSKIT_SERVICE_ANALYTICS_TOKEN:?set LEPTOSKIT_SERVICE_ANALYTICS_TOKEN}
      LEPTOSKIT_SERVICE_ANALYTICS_URL: "http://analytics:3100"
      ANALYTICS_AUTHORIZATION: "Bearer ${LEPTOSKIT_SERVICE_ANALYTICS_TOKEN}"
      ANALYTICS_PUBLIC_PATH: "/_leptoskit/services/analytics"
      LEPTOSKIT_SERVICE_BILLING_TOKEN: ${LEPTOSKIT_SERVICE_BILLING_TOKEN:?set LEPTOSKIT_SERVICE_BILLING_TOKEN}
      LEPTOSKIT_SERVICE_BILLING_URL: "https://billing.internal.example"
      LEPTOSKIT_SERVICE_CARDS_TOKEN: ${LEPTOSKIT_SERVICE_CARDS_TOKEN:?set LEPTOSKIT_SERVICE_CARDS_TOKEN}
      LEPTOSKIT_SERVICE_CARDS_URL: "http://cards:3200"
    # Nothing in the image changes while it runs.
    read_only: true
    tmpfs:
      - /tmp
    depends_on:
      db:
        condition: service_healthy
      analytics:
        condition: service_started
      cards:
        condition: service_started
    # On `docker compose down` the server fails /readyz, waits 5 seconds, and
    # gives the requests in flight 20 more, so this leaves it time to finish.
    stop_grace_period: 30s
    restart: unless-stopped

  analytics:
    build: .
    image: notes
    command: ["/app/services/analytics"]
    environment:
      LEPTOSKIT_SERVICE_NAME: analytics
      LEPTOSKIT_SERVICE_ADDR: 0.0.0.0:3100
      LEPTOSKIT_SERVICE_TOKEN: ${LEPTOSKIT_SERVICE_ANALYTICS_TOKEN:?set LEPTOSKIT_SERVICE_ANALYTICS_TOKEN}
      LEPTOSKIT_PUBLIC_ORIGIN: ${LEPTOSKIT_PUBLIC_ORIGIN:-http://localhost:3000}
      LEPTOSKIT_APP_URL: http://app:3000
      DATABASE_URL: postgres://notes_service_analytics:${LEPTOSKIT_SERVICE_ANALYTICS_DATABASE_PASSWORD}@db:5432/notes_service_analytics?sslmode=disable
      LEPTOSKIT_SERVICE_DATABASE_POOL: "4"
      LEPTOSKIT_SERVICE_VOLUME_EXPORTS: /volumes/exports
      ANALYTICS_RETENTION_DAYS: "90"
      ANALYTICS_GEOIP_KEY: ${ANALYTICS_GEOIP_KEY:?set ANALYTICS_GEOIP_KEY}
    read_only: true
    tmpfs:
      - /tmp
    volumes:
      - analytics-exports:/volumes/exports
    depends_on:
      db:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "--fail", "--silent", "--output", "/dev/null", "http://127.0.0.1:3100/readyz"]
      interval: 5s
      timeout: 3s
      retries: 10
    stop_grace_period: 30s
    restart: unless-stopped

  cards:
    build: .
    image: notes
    command: ["/app/services/cards"]
    environment:
      LEPTOSKIT_SERVICE_NAME: cards
      LEPTOSKIT_SERVICE_ADDR: 0.0.0.0:3200
      LEPTOSKIT_SERVICE_TOKEN: ${LEPTOSKIT_SERVICE_CARDS_TOKEN:?set LEPTOSKIT_SERVICE_CARDS_TOKEN}
      LEPTOSKIT_PUBLIC_ORIGIN: ${LEPTOSKIT_PUBLIC_ORIGIN:-http://localhost:3000}
      LEPTOSKIT_APP_URL: http://app:3000
    read_only: true
    tmpfs:
      - /tmp
    healthcheck:
      test: ["CMD", "curl", "--fail", "--silent", "--output", "/dev/null", "http://127.0.0.1:3200/readyz"]
      interval: 5s
      timeout: 3s
      retries: 10
    stop_grace_period: 30s
    restart: unless-stopped

  edge:
    image: caddy:2
    # Only this machine reaches it: put a proxy that terminates TLS in front
    # of it.
    ports:
      - "127.0.0.1:3000:8080"
    configs:
      - source: edge
        target: /etc/caddy/Caddyfile
    depends_on:
      - app
      - analytics
    restart: unless-stopped

  db:
    image: postgres:17
    environment:
      POSTGRES_USER: notes
      POSTGRES_DB: notes
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?set POSTGRES_PASSWORD}
      LEPTOSKIT_SERVICE_ANALYTICS_DATABASE_PASSWORD: ${LEPTOSKIT_SERVICE_ANALYTICS_DATABASE_PASSWORD:?set LEPTOSKIT_SERVICE_ANALYTICS_DATABASE_PASSWORD}
    # On its first start, with an empty volume, it gives each service a
    # database and role of its own.
    configs:
      - source: db-services
        target: /docker-entrypoint-initdb.d/10-services.sh
    volumes:
      - postgres:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD", "pg_isready", "--username=notes", "--dbname=notes"]
      interval: 5s
      timeout: 3s
      retries: 10
    restart: unless-stopped

volumes:
  postgres:
  analytics-exports:

configs:
  edge:
    content: |
      {
        admin off
        auto_https off
      }

      :8080 {
        @analytics path /_leptoskit/services/analytics /_leptoskit/services/analytics/* /_analytics /_analytics/*
        handle @analytics {
          reverse_proxy analytics:3100 {
            flush_interval -1
            header_up -Cookie
            header_down -Set-Cookie
          }
        }
        handle {
          reverse_proxy app:3000 {
            flush_interval -1
          }
        }
      }
  db-services:
    content: |
      #!/bin/sh
      set -eu
      psql --username "$$POSTGRES_USER" --dbname "$$POSTGRES_DB" --set=ON_ERROR_STOP=1 \
        --set=LEPTOSKIT_SERVICE_ANALYTICS_DATABASE_PASSWORD="$$LEPTOSKIT_SERVICE_ANALYTICS_DATABASE_PASSWORD" <<'SQL'
      REVOKE CONNECT ON DATABASE "notes" FROM PUBLIC;
      SELECT format('CREATE ROLE %I LOGIN', 'notes_service_analytics') WHERE NOT EXISTS (SELECT FROM pg_roles WHERE rolname = 'notes_service_analytics')\gexec
      ALTER ROLE "notes_service_analytics" LOGIN PASSWORD :'LEPTOSKIT_SERVICE_ANALYTICS_DATABASE_PASSWORD';
      SELECT format('CREATE DATABASE %I OWNER %I', 'notes_service_analytics', 'notes_service_analytics') WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = 'notes_service_analytics')\gexec
      REVOKE CONNECT ON DATABASE "notes_service_analytics" FROM PUBLIC;
      SQL
