---
source: crates/leptoskit_cli/src/infra/tests.rs
assertion_line: 36
expression: resources
---
{
  "data": {
    "cloudflare_zero_trust_tunnel_cloudflared_token": {
      "app": {
        "account_id": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "tunnel_id": "${cloudflare_zero_trust_tunnel_cloudflared.app.id}"
      }
    }
  },
  "output": {
    "app_url": {
      "value": "https://app.example.com"
    },
    "backup_bucket": {
      "value": "${cloudflare_r2_bucket.backups.name}"
    },
    "backup_endpoint": {
      "value": "https://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.r2.cloudflarestorage.com"
    },
    "private_ip": {
      "value": "${one(hcloud_server.app.network).ip}"
    },
    "s3_endpoint": {
      "value": "https://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.r2.cloudflarestorage.com"
    },
    "server_ip": {
      "value": "${hcloud_server.app.ipv4_address}"
    },
    "server_ips": {
      "value": "${concat([hcloud_server.app.ipv4_address], [for s in values(hcloud_server.replica) : s.ipv4_address])}"
    },
    "tunnel_token": {
      "sensitive": true,
      "value": "${data.cloudflare_zero_trust_tunnel_cloudflared_token.app.token}"
    },
    "updates_bucket": {
      "value": "${cloudflare_r2_bucket.updates.name}"
    },
    "updates_url": {
      "value": "https://updates.example.com"
    }
  },
  "provider": {
    "cloudflare": {},
    "hcloud": {}
  },
  "resource": {
    "cloudflare_dns_record": {
      "app": {
        "content": "${cloudflare_zero_trust_tunnel_cloudflared.app.id}.cfargotunnel.com",
        "name": "app.example.com",
        "proxied": true,
        "ttl": 1,
        "type": "CNAME",
        "zone_id": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
      }
    },
    "cloudflare_r2_bucket": {
      "backups": {
        "account_id": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "lifecycle": {
          "prevent_destroy": true
        },
        "name": "notes-backups"
      },
      "updates": {
        "account_id": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "lifecycle": {
          "prevent_destroy": true
        },
        "name": "notes-releases"
      }
    },
    "cloudflare_r2_custom_domain": {
      "updates": {
        "account_id": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "bucket_name": "${cloudflare_r2_bucket.updates.name}",
        "domain": "updates.example.com",
        "enabled": true,
        "min_tls": "1.2",
        "zone_id": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
      }
    },
    "cloudflare_zero_trust_tunnel_cloudflared": {
      "app": {
        "account_id": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "config_src": "cloudflare",
        "name": "notes-production"
      }
    },
    "cloudflare_zero_trust_tunnel_cloudflared_config": {
      "app": {
        "account_id": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "config": {
          "ingress": [
            {
              "hostname": "app.example.com",
              "service": "http://kamal-proxy:80"
            },
            {
              "service": "http_status:404"
            }
          ]
        },
        "tunnel_id": "${cloudflare_zero_trust_tunnel_cloudflared.app.id}"
      }
    },
    "hcloud_firewall": {
      "app": {
        "name": "notes-production-origin",
        "rule": [
          {
            "direction": "in",
            "port": "22",
            "protocol": "tcp",
            "source_ips": [
              "192.0.2.1/32"
            ]
          },
          {
            "direction": "in",
            "protocol": "icmp",
            "source_ips": [
              "0.0.0.0/0",
              "::/0"
            ]
          }
        ]
      }
    },
    "hcloud_network": {
      "app": {
        "ip_range": "10.42.0.0/16",
        "lifecycle": {
          "prevent_destroy": true
        },
        "name": "notes-production-private"
      }
    },
    "hcloud_network_subnet": {
      "app": {
        "ip_range": "10.42.0.0/24",
        "network_id": "${hcloud_network.app.id}",
        "network_zone": "eu-central",
        "type": "cloud"
      }
    },
    "hcloud_server": {
      "app": {
        "depends_on": [
          "hcloud_network_subnet.app"
        ],
        "firewall_ids": [
          "${hcloud_firewall.app.id}"
        ],
        "image": "ubuntu-24.04",
        "lifecycle": {
          "prevent_destroy": true
        },
        "location": "hel1",
        "name": "notes-production",
        "network": [
          {
            "ip": "10.42.0.10",
            "network_id": "${hcloud_network.app.id}"
          }
        ],
        "public_net": [
          {
            "ipv4_enabled": true,
            "ipv6_enabled": true
          }
        ],
        "server_type": "cx23",
        "ssh_keys": [
          "123"
        ],
        "user_data": "#cloud-config\nssh_pwauth: false\ndisable_root: false\npackage_update: true\npackages:\n  - docker.io\n  - unattended-upgrades\n  - restic\n  - python3\nwrite_files:\n  - path: /etc/ssh/sshd_config.d/00-leptoskit.conf\n    content: |\n      PasswordAuthentication no\n      PermitRootLogin prohibit-password\n  - path: /etc/docker/daemon.json\n    content: '{\"log-driver\":\"local\",\"log-opts\":{\"max-size\":\"10m\",\"max-file\":\"3\"}}'\nruncmd:\n  - systemctl enable --now docker\n  - sshd -t\n  - systemctl restart ssh\n"
      },
      "replica": {
        "depends_on": [
          "hcloud_network_subnet.app"
        ],
        "firewall_ids": [
          "${hcloud_firewall.app.id}"
        ],
        "for_each": {},
        "image": "ubuntu-24.04",
        "location": "hel1",
        "name": "notes-production-${each.key}",
        "network": [
          {
            "ip": "${each.value}",
            "network_id": "${hcloud_network.app.id}"
          }
        ],
        "public_net": [
          {
            "ipv4_enabled": true,
            "ipv6_enabled": true
          }
        ],
        "server_type": "cx23",
        "ssh_keys": [
          "123"
        ],
        "user_data": "#cloud-config\nssh_pwauth: false\ndisable_root: false\npackage_update: true\npackages:\n  - docker.io\n  - unattended-upgrades\n  - restic\n  - python3\nwrite_files:\n  - path: /etc/ssh/sshd_config.d/00-leptoskit.conf\n    content: |\n      PasswordAuthentication no\n      PermitRootLogin prohibit-password\n  - path: /etc/docker/daemon.json\n    content: '{\"log-driver\":\"local\",\"log-opts\":{\"max-size\":\"10m\",\"max-file\":\"3\"}}'\nruncmd:\n  - systemctl enable --now docker\n  - sshd -t\n  - systemctl restart ssh\n"
      }
    }
  },
  "terraform": {
    "required_providers": {
      "cloudflare": {
        "source": "cloudflare/cloudflare",
        "version": "~> 5.0"
      },
      "hcloud": {
        "source": "hetznercloud/hcloud",
        "version": "~> 1.0"
      }
    },
    "required_version": ">= 1.10, < 2.0"
  }
}
