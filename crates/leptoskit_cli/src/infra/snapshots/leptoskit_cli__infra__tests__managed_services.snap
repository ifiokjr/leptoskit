---
source: crates/leptoskit_cli/src/infra/tests.rs
expression: yaml
---
{
  "accessories": {
    "db": {
      "directories": [
        "/var/lib/leptoskit/notes-production/postgres:/var/lib/postgresql/data"
      ],
      "env": {
        "clear": {
          "POSTGRES_DB": "leptoskit",
          "POSTGRES_USER": "leptoskit_admin"
        },
        "secret": [
          "POSTGRES_PASSWORD",
          "DATABASE_PASSWORD"
        ]
      },
      "files": [
        "db-init.sh:/docker-entrypoint-initdb.d/01-leptoskit.sh:ro"
      ],
      "host": "192.0.2.10",
      "image": "postgres:17",
      "options": {
        "network": "kamal"
      },
      "port": "10.42.0.10:5432:5432"
    },
    "tunnel": {
      "cmd": "tunnel --no-autoupdate run",
      "env": {
        "secret": [
          "TUNNEL_TOKEN"
        ]
      },
      "hosts": [
        "192.0.2.10"
      ],
      "image": "cloudflare/cloudflared:latest",
      "options": {
        "network": "kamal"
      }
    }
  },
  "boot": {
    "limit": 1,
    "wait": 2
  },
  "builder": {
    "arch": "amd64"
  },
  "deploy_timeout": 90,
  "drain_timeout": 30,
  "image": "team/notes",
  "proxy": {
    "app_port": 3000,
    "forward_headers": true,
    "healthcheck": {
      "interval": 2,
      "path": "/readyz",
      "timeout": 5
    },
    "host": "app.example.com",
    "ssl": false
  },
  "registry": {
    "password": [
      "KAMAL_REGISTRY_PASSWORD"
    ],
    "server": "ghcr.io",
    "username": "team"
  },
  "retain_containers": 5,
  "servers": {
    "service-analytics": {
      "cmd": "/app/services/analytics",
      "env": {
        "clear": {
          "ANALYTICS_RETENTION_DAYS": "90",
          "LEPTOSKIT_APP_URL": "http://notes-production-app:3000",
          "LEPTOSKIT_PUBLIC_ORIGIN": "https://app.example.com",
          "LEPTOSKIT_SERVICE_ADDR": "0.0.0.0:3100",
          "LEPTOSKIT_SERVICE_DATABASE_POOL": "4",
          "LEPTOSKIT_SERVICE_NAME": "analytics",
          "LEPTOSKIT_SERVICE_VOLUME_EXPORTS": "/volumes/exports"
        },
        "secret": [
          "LEPTOSKIT_SERVICE_TOKEN:LEPTOSKIT_SERVICE_ANALYTICS_TOKEN",
          "DATABASE_URL:LEPTOSKIT_SERVICE_ANALYTICS_DATABASE_URL",
          "ANALYTICS_GEOIP_KEY"
        ]
      },
      "hosts": [
        "192.0.2.10"
      ],
      "options": {
        "cap-drop": "ALL",
        "network-alias": "notes-production-analytics",
        "read-only": true,
        "security-opt": "no-new-privileges:true",
        "tmpfs": "/tmp:rw,nosuid,nodev,size=64m",
        "volume": [
          "/var/lib/leptoskit/notes-production/services/analytics/exports:/volumes/exports"
        ]
      },
      "proxy": {
        "app_port": 3100,
        "forward_headers": true,
        "healthcheck": {
          "interval": 2,
          "path": "/readyz",
          "timeout": 5
        },
        "host": "app.example.com",
        "path_prefix": "/_leptoskit/services/analytics,/_analytics",
        "ssl": false,
        "strip_path_prefix": false
      }
    },
    "service-cards": {
      "cmd": "/app/services/cards",
      "env": {
        "clear": {
          "LEPTOSKIT_APP_URL": "http://notes-production-app:3000",
          "LEPTOSKIT_PUBLIC_ORIGIN": "https://app.example.com",
          "LEPTOSKIT_SERVICE_ADDR": "0.0.0.0:3200",
          "LEPTOSKIT_SERVICE_NAME": "cards"
        },
        "secret": [
          "LEPTOSKIT_SERVICE_TOKEN:LEPTOSKIT_SERVICE_CARDS_TOKEN"
        ]
      },
      "hosts": [
        "192.0.2.10"
      ],
      "options": {
        "cap-drop": "ALL",
        "network-alias": "notes-production-cards",
        "read-only": true,
        "security-opt": "no-new-privileges:true",
        "tmpfs": "/tmp:rw,nosuid,nodev,size=64m"
      }
    },
    "web": {
      "env": {
        "clear": {
          "ANALYTICS_PUBLIC_PATH": "/_leptoskit/services/analytics",
          "LEPTOSKIT_SERVICE_ANALYTICS_URL": "http://notes-production-analytics:3100",
          "LEPTOSKIT_SERVICE_BILLING_URL": "https://billing.internal.example",
          "LEPTOSKIT_SERVICE_CARDS_URL": "http://notes-production-cards:3200",
          "LEPTOS_ENV": "PROD",
          "LEPTOS_OUTPUT_NAME": "notes_app",
          "LEPTOS_SITE_ADDR": "0.0.0.0:3000",
          "LEPTOS_SITE_ROOT": "/app/dist"
        },
        "secret": [
          "AUTH_KEY",
          "DATABASE_URL",
          "LEPTOSKIT_SERVICE_ANALYTICS_TOKEN",
          "ANALYTICS_AUTHORIZATION",
          "LEPTOSKIT_SERVICE_BILLING_TOKEN",
          "LEPTOSKIT_SERVICE_CARDS_TOKEN"
        ]
      },
      "hosts": [
        "192.0.2.10"
      ],
      "options": {
        "cap-drop": "ALL",
        "network-alias": "notes-production-app",
        "read-only": true,
        "security-opt": "no-new-privileges:true",
        "tmpfs": "/tmp:rw,nosuid,nodev,size=64m"
      }
    }
  },
  "service": "notes-production"
}
