  "image": "team/notes",
  "proxy": {
    "app_port": 3000,
    "forward_headers": true,
    "healthcheck": {
      "interval": 2,
      "path": "/readyz",
      "timeout": 5
    },
    "host": "app.example.com",
    "ssl": false
  },
  "registry": {
    "password": [
      "KAMAL_REGISTRY_PASSWORD"
    ],
    "server": "ghcr.io",
    "username": "team"
