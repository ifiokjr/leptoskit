        "user": "1000:1000"
      },
      "port": "10.42.0.10:4222:4222"
    },
    "tunnel": {
      "cmd": "tunnel --no-autoupdate run",
      "env": {
        "secret": [
          "TUNNEL_TOKEN"
        ]
      },
      "hosts": [
        "192.0.2.10",
        "192.0.2.11"
      ],
      "image": "cloudflare/cloudflared:latest",
      "options": {
        "network": "kamal"
      }
    }
  },
  "boot": {
    "limit": 1,
    "wait": 2
  },
  "builder": {
    "arch": "amd64"
  },
  "deploy_timeout": 90,
  "drain_timeout": 30,
  "env": {
    "clear": {
      "LEPTOS_ENV": "PROD",
      "LEPTOS_OUTPUT_NAME": "notes",
      "LEPTOS_SITE_ADDR": "0.0.0.0:3000",
      "LEPTOS_SITE_ROOT": "/app/dist"
