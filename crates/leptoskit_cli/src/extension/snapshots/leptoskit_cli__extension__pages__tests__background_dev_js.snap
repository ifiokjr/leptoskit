expression: "background_js(&module, None, Some(\"http://127.0.0.1:3000\"))"
---
// Generated by leptoskit: the development worker.
const api = globalThis.browser ?? globalThis.chrome;

// Development: reload the extension when `leptoskit dev` finishes a new build.
(async () => {
  let after = "";
  for (;;) {
    try {
      const response = await fetch("http://127.0.0.1:3000" + "/_leptoskit/extension/build?after=" + after);
      const build = await response.text();
      if (after && build !== after) return api.runtime.reload();
      after = build;
    } catch {
      await new Promise((resolve) => setTimeout(resolve, 1000));
    }
  }
})();
