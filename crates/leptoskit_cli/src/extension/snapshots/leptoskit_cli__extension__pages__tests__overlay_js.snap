// Generated by leptoskit: a content script's interface, in the extension's own frame.
import init, { leptoskit_extension_start } from "./pkg/app.js";

const frame = JSON.parse(decodeURIComponent(location.hash.slice(1)));
await init({ module_or_path: new URL("./pkg/app_bg.wasm", import.meta.url) });
leptoskit_extension_start("content:" + frame.name, frame.route);
