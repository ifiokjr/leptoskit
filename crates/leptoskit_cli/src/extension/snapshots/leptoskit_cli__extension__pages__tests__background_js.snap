---
source: crates/leptoskit_cli/src/extension/pages.rs
expression: "background_js(&module,\nSome(&[\"runtime.message\".into(), \"context_menus\".into(), \"alarms\".into()]),\nNone)"
---
// Generated by leptoskit: the background worker.
import init, { leptoskit_extension_background, leptoskit_extension_event } from "./pkg/app.js";

const api = globalThis.browser ?? globalThis.chrome;
let ready = false;
const queue = [];

// Every event reaches the app's handler once the wasm is ready; a reply goes back to the
// sender, and a failure as `{ __leptoskit_error }`.
function deliver(kind, detail, reply) {
  const run = () =>
    leptoskit_extension_event(kind, detail ?? null).then(
      (answer) => reply?.(answer),
      (error) => reply?.({ __leptoskit_error: String(error?.message ?? error) }),
    );
  if (ready) run();
  else queue.push(run);
}

api.runtime.onMessage.addListener((message, sender, sendResponse) => {
  deliver("runtime.message", { message, sender }, sendResponse);
  // Keeps the channel open for the reply, in every browser.
  return true;
});
api.alarms.onAlarm.addListener((alarm) => deliver("alarms", alarm));
api.contextMenus.onClicked.addListener((info, tab) => deliver("context_menus", ({ info, tab })));

init({ module_or_path: new URL("./pkg/app_bg.wasm", import.meta.url) }).then(() => {
  leptoskit_extension_background();
  ready = true;
  for (const run of queue.splice(0)) run();
});
