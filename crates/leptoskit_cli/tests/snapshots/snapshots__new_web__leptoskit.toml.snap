---
source: crates/leptoskit_cli/tests/snapshots.rs
expression: contents
---
plugins = []

[app]
name = "snapshotted"
version = "0.1.0"
default_platform = "web"
render = "csr"

[serve]
address = "127.0.0.1"
port = 3000

[build]
features = []
split = false
wasm_opt = true
precompress = true
rustflags = []

[native]
package_id = "com.leptoskit.snapshotted"
targets = [
    "macos",
    "ios",
    "android",
]
viewport_width = 390.0
viewport_height = 844.0

[codepush]
enabled = false
server = ""
channel = "production"
mandatory = false
staging_dir = "codepush"
public_keys = []
