---
source: crates/leptoskit_cli/tests/snapshots.rs
expression: contents
---
# Monosecret resolves these names before leptoskit dev starts.
# Commit declarations; store values in a provider, never in this file.
[defaults]
providers = [
    "env",
    "keyring",
]

[profiles.default.DATABASE_URL]
default = "sqlite://snapshotted.sqlite3"
description = "Database connection URL"
required = false

[project]
name = "snapshotted"
revision = "1.0"
