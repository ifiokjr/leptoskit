---
source: crates/leptoskit_cli/tests/snapshots.rs
expression: contents
---
[package]
name = "snapshotted"
version = "0.1.0"
edition = "2024"
publish = false

[lib]
name = "leptoskit_app"
crate-type = ["staticlib"]

[workspace]
members = ["guest"]

[profile.release]
lto = "thin"
codegen-units = 1

# Keep host proc-macros loadable on macOS 27 (rust-lang/rust#157750).
[profile.release.build-override]
strip = "none"

[dependencies.leptoskit_bridge_ffi]
features = ["app"]
version = "=0.1.0"

[dependencies.leptoskit_bridge]
version = "=0.1.0"

[dependencies.leptoskit_plugin_os]
version = "=0.1.0"

[dependencies.leptoskit_plugin_crypto]
version = "=0.1.0"

[dependencies.leptoskit_plugin_clipboard]
version = "=0.1.0"
