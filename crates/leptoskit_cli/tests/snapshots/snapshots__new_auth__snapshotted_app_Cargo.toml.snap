---
source: crates/leptoskit_cli/tests/snapshots.rs
expression: contents
---
[package]
name = "snapshotted_app"
version = "0.1.0"
edition = "2024"
publish = false

[lib]
crate-type = ["rlib", "cdylib"]

[features]
default = []
web = ["leptoskit/web", "dep:leptos", "dep:wasm-bindgen"]
native = ["leptoskit/guest", "dep:any_spawner", "dep:futures"]
ios = ["native", "leptoskit/ios"]
android = ["native", "leptoskit/android"]
macos = ["native", "leptoskit/macos"]
windows = ["native", "leptoskit/windows"]
linux = ["native", "leptoskit/linux"]
tui = ["native", "leptoskit/tui"]
csr = ["web", "leptos/csr"]
hydrate = ["web", "leptos/hydrate"]
ssr = ["web", "leptos/ssr"]
# The DevTools agents; `leptoskit dev` turns this on, `leptoskit build` never does.
devtools = ["leptoskit/devtools"]

[dependencies]
snapshotted_shared = { path = "../snapshotted_shared" }
leptoskit = { version = "=[version]", default-features = false, features = ["auth", "leptos", "query"] }
leptos = { version = "0.9.0-rc0", default-features = false, optional = true }
# The embedded wasm-bindgen CLI accepts exactly its matching library version.
wasm-bindgen = { version = "=0.2.129", optional = true }
# The native build's executor for sign-in requests.
any_spawner = { version = "0.3", optional = true }
futures = { version = "0.3", default-features = false, features = ["executor"], optional = true }

[build-dependencies]
leptoskit_build = { version = "=[version]", default-features = false }
