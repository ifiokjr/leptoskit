[package]
name = "snapshotted_client"
version = "0.1.0"
edition = "2024"
publish = false

[lib]
crate-type = ["cdylib"]

[dependencies]
# Pinned exactly: leptoskit binds the client with an embedded wasm-bindgen
# 0.2.129, and wasm-bindgen only accepts wasm built against its own version.
wasm-bindgen = "=0.2.129"
