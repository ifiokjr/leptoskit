{
	"useTabs": true,
	"indentWidth": 2,
	"typescript": {
		"deno": true,
		"useTabs": true,
		"module.sortExportDeclarations": "caseInsensitive",
		"module.sortImportDeclarations": "caseInsensitive"
	},
	"exec": {
		"commands": [
			{
				"command": "nixfmt",
				"exts": [
					"nix"
				]
			},
			{
				"command": "sql-formatter -c ./setup/.sql-formatter.json",
				"exts": [
					"sql"
				]
			},
			{
				"command": "shfmt --filename {{file_path}} -i 0",
				"exts": [
					"sh",
					"bash"
				]
			}
		]
	},
	"incremental": true,
	"json": {
		"deno": true,
		"useTabs": true
	},
	"markdown": {
		"deno": true,
		"textWrap": "never"
	},
	"toml": {
		"comment.forceLeadingSpace": false,
		"useTabs": true,
		"indentWidth": 2,
		"cargo.applyConventions": true
	},
	"includes": [
		"**/*.{ts,tsx,js,jsx,cjs,mjs,json,jsonc,md,toml,Dockerfile,yml,yaml,css,sh,bash,sql}"
	],
	"excludes": [
		"deno.lock",
		"**/dist",
		".devenv/**",
		"**/fixtures",
		// Migrations are generated, applied exactly as written, and
		// checksummed, so formatting one would change history.
		"**/migrations/*/migration.sql",
		"**/migrations/*/schema.json",
		"**/migrations-*/*/migration.sql",
		"**/migrations-*/*/schema.json",
		"**/snapshots",
		"**/target",
		"**/.build",
		"**/node_modules",
		"docs/dist/**",
		".monochange/**",
		".bin/",
		".local-cache/",
		".video_agent/",
		"**/dist/**",
		"**/pkg/",
		"benchmarks/apps/runtime/*/bench.js",
		"benchmarks/apps/**/vendor/**",
		"benchmarks/apps/runtime/flutter/build/**",
		"benchmarks/apps/runtime/flutter/.dart_tool/**",
		"examples/harbor/clients/**",
		"benchmarks/arena/apps/**/package-lock.json",
		"benchmarks/arena/apps/**/build/**",
		"benchmarks/arena/apps/**/.dart_tool/**",
		"benchmarks/arena/apps/**/.gradle/**",
		"benchmarks/arena/apps/**/Pods/**",
		"benchmarks/arena/apps/**/*.xcassets/**",
		"benchmarks/arena/apps/**/*.xcodeproj/**",
		"benchmarks/arena/apps/**/*.xcworkspace/**",
		"benchmarks/arena/apps/**/assets/**"
	],
	"plugins": [
		"https://plugins.dprint.dev/typescript-0.93.3.wasm",
		"https://plugins.dprint.dev/json-0.19.4.wasm",
		"https://plugins.dprint.dev/markdown-0.17.8.wasm",
		"https://plugins.dprint.dev/exec-0.5.1.json@492414e39dea4dccc07b4af796d2f4efdb89e84bae2bd4e1e924c0cc050855bf",
		"https://plugins.dprint.dev/g-plane/pretty_yaml-v0.5.0.wasm",
		"https://plugins.dprint.dev/g-plane/markup_fmt-v0.18.0.wasm",
		"https://plugins.dprint.dev/g-plane/malva-v0.11.1.wasm",
		"https://plugins.dprint.dev/toml-0.6.4.wasm"
	]
}
