{
	"deno.enable": true,
	"deno.testing.enable": true,
	"deno.lint": true,
	"[markdown]": {
		"editor.defaultFormatter": "dprint.dprint"
	},
	"[typescript]": {
		"editor.defaultFormatter": "dprint.dprint"
	},
	"[typescriptreact]": {
		"editor.defaultFormatter": "dprint.dprint"
	},
	"[javascript]": {
		"editor.defaultFormatter": "dprint.dprint"
	},
	"[javascriptreact]": {
		"editor.defaultFormatter": "dprint.dprint"
	},
	"[json]": {
		"editor.defaultFormatter": "dprint.dprint"
	},
	"[jsonc]": {
		"editor.defaultFormatter": "dprint.dprint"
	},
	"[toml]": {
		"editor.defaultFormatter": "dprint.dprint"
	},
	"[yaml]": {
		"editor.defaultFormatter": "dprint.dprint"
	},
	"[rust]": {
		"editor.defaultFormatter": "rust-lang.rust-analyzer"
	},
	"rust-analyzer.rustfmt.overrideCommand": [
		"cargo",
		"run",
		"--quiet",
		"--package",
		"leptoskit_fmt",
		"--features",
		"cli",
		"--bin",
		"leptoskit-fmt",
		"--",
		"--stdin"
	]
}
